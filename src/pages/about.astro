---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="About SRA — Timeless fashion with a modern perspective."
    />

    <title>About SRA | Timeless Fashion</title>
  </head>

  <body>

    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="about-hero">

        <div class="about-hero-content">

          <span>
            ABOUT SRA
          </span>

          <h1>
            Timeless.<br />
            Modern.<br />
            Yours.
          </h1>

          <p>
            A fashion collection created for those
            who believe personal style should feel
            effortless, confident and entirely their own.
          </p>

        </div>

        <div class="hero-scroll">

          <span>
            OUR STORY
          </span>

          <span class="scroll-line"></span>

        </div>

      </section>


      <!-- =====================================================
           INTRO
      ====================================================== -->

      <section class="about-intro">

        <div class="intro-label">
          THE SRA PHILOSOPHY
        </div>

        <h2>
          Fashion that feels<br />
          like you.
        </h2>

        <p>
          SRA was created around a simple idea:
          clothing should not only look beautiful,
          it should feel right.
        </p>

        <p>
          We bring together timeless silhouettes,
          modern details and effortless styling
          to create pieces that can become part
          of your everyday wardrobe.
        </p>

      </section>


      <!-- =====================================================
           STORY
      ====================================================== -->

      <section class="story-section">

        <div class="story-image">

          <div class="image-frame">

            <div class="frame-letter">
              S
            </div>

          </div>

        </div>


        <div class="story-content">

          <span>
            OUR APPROACH
          </span>

          <h2>
            Less noise.<br />
            More style.
          </h2>

          <p>
            We believe great fashion does not need
            to be complicated. The right cut, the right
            fabric and the right detail can create
            something that feels completely effortless.
          </p>

          <p>
            SRA focuses on versatile pieces designed
            to move naturally between everyday moments,
            work, occasions and everything in between.
          </p>

          <div class="story-line"></div>

          <strong>
            SRA COLLECTION
          </strong>

        </div>

      </section>


      <!-- =====================================================
           VALUES
      ====================================================== -->

      <section class="values-section">

        <div class="values-heading">

          <span>
            WHAT WE BELIEVE
          </span>

          <h2>
            The SRA values.
          </h2>

        </div>


        <div class="values-grid">

          <!-- VALUE 01 -->

          <article class="value-card">

            <span>
              01
            </span>

            <h3>
              Timeless
            </h3>

            <p>
              Designs that stay relevant beyond
              a single season or passing trend.
            </p>

          </article>


          <!-- VALUE 02 -->

          <article class="value-card">

            <span>
              02
            </span>

            <h3>
              Effortless
            </h3>

            <p>
              Pieces that are easy to wear,
              style and make your own.
            </p>

          </article>


          <!-- VALUE 03 -->

          <article class="value-card">

            <span>
              03
            </span>

            <h3>
              Confident
            </h3>

            <p>
              Clothing designed to help you
              feel comfortable in your own style.
            </p>

          </article>


          <!-- VALUE 04 -->

          <article class="value-card">

            <span>
              04
            </span>

            <h3>
              Personal
            </h3>

            <p>
              Because the best wardrobe is one
              that reflects the person wearing it.
            </p>

          </article>

        </div>

      </section>


      <!-- =====================================================
           BRAND STATEMENT
      ====================================================== -->

      <section class="brand-statement">

        <span>
          THE SRA WAY
        </span>

        <h2>
          Wear what<br />
          feels like you.
        </h2>

        <p>
          Timeless pieces. Modern perspective.
          A wardrobe made entirely your own.
        </p>

        <a href="/women">
          DISCOVER SRA →
        </a>

      </section>

    </main>


    <Footer />

  </body>
</html>


<style>

/* =====================================================
   RESET
===================================================== */

* {
  box-sizing: border-box;
}


html {
  scroll-behavior: smooth;
}


body {
  margin: 0;

  background: #f6f2e9;

  color: #0b1f3a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


a {
  color: inherit;
}


/* =====================================================
   HERO
===================================================== */

.about-hero {

  position: relative;

  min-height:
    calc(100vh - 100px);

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  border-bottom:
    1px solid #e3ddd1;

  text-align: center;
}


.about-hero-content {

  width: 100%;

  max-width: 900px;

  padding:
    100px 25px 130px;
}


.about-hero-content > span {

  display: block;

  margin-bottom:
    28px;

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    3px;
}


.about-hero h1 {

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(70px, 9vw, 135px);

  font-weight:
    400;

  line-height:
    .88;

  letter-spacing:
    -6px;
}


.about-hero p {

  max-width:
    450px;

  margin:
    38px auto 0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


.hero-scroll {

  position:
    absolute;

  left:
    50%;

  bottom:
    28px;

  transform:
    translateX(-50%);

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    10px;

  color:
    #8b857b;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.8px;
}


.scroll-line {

  width:
    1px;

  height:
    32px;

  background:
    #b8b0a4;
}


/* =====================================================
   INTRO
===================================================== */

.about-intro {

  max-width:
    850px;

  margin:
    0 auto;

  padding:
    150px 30px;

  text-align:
    center;
}


.intro-label {

  margin-bottom:
    20px;

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    2.5px;
}


.about-intro h2 {

  margin:
    0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(45px, 5vw, 70px);

  font-weight:
    400;

  line-height:
    1;

  letter-spacing:
    -2.5px;
}


.about-intro p {

  max-width:
    560px;

  margin:
    30px auto 0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


/* =====================================================
   STORY
===================================================== */

.story-section {

  display:
    grid;

  grid-template-columns:
    1fr 1fr;

  min-height:
    650px;

  margin:
    0 35px;

  background:
    #ebe5da;
}


.story-image {

  min-height:
    650px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    linear-gradient(
      145deg,
      #d7d0c4,
      #ebe5da
    );

  overflow:
    hidden;
}


.image-frame {

  width:
    65%;

  aspect-ratio:
    4 / 5;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border:
    1px solid rgba(11, 31, 58, .35);

  position:
    relative;
}


.image-frame::before {

  content:
    "";

  position:
    absolute;

  inset:
    15px;

  border:
    1px solid rgba(176, 140, 77, .6);
}


.frame-letter {

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(120px, 15vw, 230px);

  font-weight:
    400;

  color:
    #0b1f3a;

  line-height:
    1;
}


.story-content {

  display:
    flex;

  flex-direction:
    column;

  justify-content:
    center;

  padding:
    80px;
}


.story-content > span {

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    2px;
}


.story-content h2 {

  margin:
    18px 0 25px;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(45px, 5vw, 70px);

  font-weight:
    400;

  line-height:
    .95;

  letter-spacing:
    -3px;
}


.story-content p {

  max-width:
    450px;

  margin:
    0 0 18px;

  color:
    #777269;

  font-size:
    11px;

  line-height:
    1.9;
}


.story-line {

  width:
    45px;

  height:
    1px;

  margin:
    18px 0;

  background:
    #b08c4d;
}


.story-content strong {

  color:
    #0b1f3a;

  font-size:
    8px;

  letter-spacing:
    2px;
}


/* =====================================================
   VALUES
===================================================== */

.values-section {

  padding:
    150px 50px;
}


.values-heading {

  text-align:
    center;

  margin-bottom:
    65px;
}


.values-heading span {

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    2px;
}


.values-heading h2 {

  margin:
    12px 0 0;

  font-family:
    Georgia,
    serif;

  font-size:
    48px;

  font-weight:
    400;

  letter-spacing:
    -2px;
}


.values-grid {

  display:
    grid;

  grid-template-columns:
    repeat(4, 1fr);

  border-top:
    1px solid #d8d1c5;

  border-left:
    1px solid #d8d1c5;
}


.value-card {

  min-height:
    260px;

  padding:
    30px;

  border-right:
    1px solid #d8d1c5;

  border-bottom:
    1px solid #d8d1c5;

  transition:
    background .25s ease,
    color .25s ease;
}


.value-card:hover {

  background:
    #0b1f3a;

  color:
    white;
}


.value-card > span {

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    1px;
}


.value-card h3 {

  margin:
    60px 0 20px;

  font-family:
    Georgia,
    serif;

  font-size:
    30px;

  font-weight:
    400;
}


.value-card p {

  max-width:
    220px;

  margin:
    0;

  color:
    #777269;

  font-size:
    10px;

  line-height:
    1.8;
}


.value-card:hover p {

  color:
    #d4d7dc;
}


/* =====================================================
   BRAND STATEMENT
===================================================== */

.brand-statement {

  padding:
    180px 25px;

  text-align:
    center;

  background:
    #0b1f3a;

  color:
    white;
}


.brand-statement > span {

  color:
    #c7a66b;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    2.5px;
}


.brand-statement h2 {

  margin:
    20px 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(60px, 8vw, 110px);

  font-weight:
    400;

  line-height:
    .9;

  letter-spacing:
    -5px;
}


.brand-statement p {

  margin:
    25px auto 30px;

  color:
    #c9cbd0;

  font-size:
    11px;

  line-height:
    1.8;
}


.brand-statement a {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  height:
    48px;

  padding:
    0 25px;

  border:
    1px solid white;

  color:
    white;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    1.3px;

  text-decoration:
    none;

  transition:
    .25s ease;
}


.brand-statement a:hover {

  background:
    white;

  color:
    #0b1f3a;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 900px) {

  .story-section {

    grid-template-columns:
      1fr;
  }


  .story-image {

    min-height:
      550px;
  }


  .values-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  body {

    overflow-x:
      hidden;
  }


  /* HERO */

  .about-hero {

    min-height:
      calc(100vh - 80px);
  }


  .about-hero-content {

    padding:
      75px 18px 110px;
  }


  .about-hero-content > span {

    font-size:
      8px;

    letter-spacing:
      2.3px;
  }


  .about-hero h1 {

    font-size:
      58px;

    line-height:
      .92;

    letter-spacing:
      -3px;
  }


  .about-hero p {

    max-width:
      310px;

    margin-top:
      28px;

    font-size:
      10px;
  }


  /* INTRO */

  .about-intro {

    padding:
      90px 22px;
  }


  .about-intro h2 {

    font-size:
      36px;

    letter-spacing:
      -1.5px;
  }


  .about-intro p {

    font-size:
      10px;

    line-height:
      1.8;
  }


  /* STORY */

  .story-section {

    margin:
      0 12px;
  }


  .story-image {

    min-height:
      420px;
  }


  .image-frame {

    width:
      65%;
  }


  .story-content {

    padding:
      55px 25px;
  }


  .story-content h2 {

    font-size:
      42px;

    letter-spacing:
      -1.5px;
  }


  .story-content p {

    font-size:
      10px;
  }


  /* VALUES */

  .values-section {

    padding:
      90px 12px;
  }


  .values-heading {

    margin-bottom:
      35px;
  }


  .values-heading h2 {

    font-size:
      35px;
  }


  .values-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }


  .value-card {

    min-height:
      185px;

    padding:
      18px;
  }


  .value-card h3 {

    margin:
      35px 0 15px;

    font-size:
      23px;
  }


  .value-card p {

    font-size:
      9px;
  }


  /* BRAND STATEMENT */

  .brand-statement {

    padding:
      110px 20px;
  }


  .brand-statement h2 {

    font-size:
      58px;

    letter-spacing:
      -3px;
  }


  .brand-statement p {

    font-size:
      9px;
  }

}


/* =====================================================
   SMALL PHONE
===================================================== */

@media (max-width: 380px) {

  .about-hero h1 {

    font-size:
      51px;
  }


  .about-intro h2 {

    font-size:
      32px;
  }


  .story-content h2 {

    font-size:
      36px;
  }


  .value-card h3 {

    font-size:
      20px;
  }


  .brand-statement h2 {

    font-size:
      49px;
  }

}

</style>
