---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Frequently Asked Questions about SRA Fashion, orders, payments, shipping and returns."
    />

    <title>FAQ | SRA</title>
  </head>

  <body>

    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="faq-hero">

        <div class="hero-content">

          <span>
            SRA CUSTOMER CARE
          </span>

          <h1>
            Frequently<br />
            Asked Questions.
          </h1>

          <p>
            Find answers to the most common questions
            about SRA orders, products, payments and delivery.
          </p>

        </div>

      </section>


      <!-- =====================================================
           FAQ SECTION
      ====================================================== -->

      <section class="faq-section">

        <div class="faq-header">

          <span>
            NEED TO KNOW
          </span>

          <h2>
            How can we help?
          </h2>

        </div>


        <div class="faq-list">


          <!-- FAQ 01 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                01
              </span>

              <span class="question">
                How can I place an order?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Browse the SRA collection and select the product
                you would like to purchase. Choose your preferred
                size, add the item to your cart and proceed to
                checkout. Follow the instructions on the checkout
                page to complete your order.
              </p>

            </div>

          </details>


          <!-- FAQ 02 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                02
              </span>

              <span class="question">
                What payment methods do you accept?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                SRA supports secure online payments. Depending
                on the available options at checkout, you may
                be able to pay using cards, UPI, net banking
                and other supported payment methods.
              </p>

            </div>

          </details>


          <!-- FAQ 03 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                03
              </span>

              <span class="question">
                How long does delivery take?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Orders are generally processed within 1–2
                business days. Once dispatched, delivery usually
                takes around 3–7 business days depending on
                your location.
              </p>

            </div>

          </details>


          <!-- FAQ 04 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                04
              </span>

              <span class="question">
                Can I track my order?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Yes. Once your order has been dispatched,
                tracking information will be provided when
                available. You can use the tracking details
                to follow the progress of your delivery.
              </p>

            </div>

          </details>


          <!-- FAQ 05 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                05
              </span>

              <span class="question">
                Can I cancel my order?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                If your order has not yet been processed for
                dispatch, you may be able to request a
                cancellation. Please contact our customer
                care team as soon as possible with your
                order details.
              </p>

            </div>

          </details>


          <!-- FAQ 06 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                06
              </span>

              <span class="question">
                How do I return a product?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Please review our Returns &amp; Exchanges policy
                for eligibility and instructions. If your item
                qualifies, contact our customer care team and
                provide your order details to begin the process.
              </p>

            </div>

          </details>


          <!-- FAQ 07 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                07
              </span>

              <span class="question">
                Can I exchange a product for another size?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Size exchanges may be available depending on
                stock and the condition of the product. Please
                contact our customer care team before sending
                an item back.
              </p>

            </div>

          </details>


          <!-- FAQ 08 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                08
              </span>

              <span class="question">
                What should I do if my order arrives damaged?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                Please contact SRA customer care as soon as
                possible after receiving the package. Include
                your order number and clear photographs of the
                damaged packaging or product so our team can
                assist you.
              </p>

            </div>

          </details>


          <!-- FAQ 09 -->

          <details class="faq-item">

            <summary>

              <span class="faq-number">
                09
              </span>

              <span class="question">
                How can I contact SRA?
              </span>

              <span class="plus">
                +
              </span>

            </summary>

            <div class="answer">

              <p>
                You can reach our team through the Contact Us
                page. We will be happy to help with questions
                about products, orders, shipping and returns.
              </p>

              <a href="/contact">
                CONTACT US →
              </a>

            </div>

          </details>


        </div>

      </section>


      <!-- =====================================================
           CTA
      ====================================================== -->

      <section class="faq-cta">

        <span>
          STILL HAVE QUESTIONS?
        </span>

        <h2>
          We're here<br />
          to help.
        </h2>

        <p>
          Can't find what you're looking for?
          Get in touch with our team.
        </p>

        <a href="/contact">
          CONTACT SRA →
        </a>

      </section>

    </main>


    <Footer />


  </body>
</html>


<style>

  /* =====================================================
     RESET
  ====================================================== */

  * {
    box-sizing: border-box;
  }


  html {
    scroll-behavior: smooth;
  }


  body {
    margin: 0;

    background: #f6f2e9;

    color: #0b1f3a;

    font-family:
      Arial,
      Helvetica,
      sans-serif;
  }


  a {
    color: inherit;
  }


  /* =====================================================
     HERO
  ====================================================== */

  .faq-hero {

    min-height: 560px;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 100px 30px;

    text-align: center;

    border-bottom:
      1px solid #e3ddd1;
  }


  .hero-content {

    max-width: 850px;
  }


  .hero-content > span {

    display: block;

    margin-bottom: 25px;

    color: #b08c4d;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 3px;
  }


  .hero-content h1 {

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(52px, 7.5vw, 100px);

    font-weight: 400;

    line-height: .92;

    letter-spacing: -5px;
  }


  .hero-content p {

    max-width: 480px;

    margin: 35px auto 0;

    color: #777269;

    font-size: 12px;

    line-height: 1.9;
  }


  /* =====================================================
     FAQ SECTION
  ====================================================== */

  .faq-section {

    max-width: 1050px;

    margin: 0 auto;

    padding: 140px 30px;
  }


  .faq-header {

    text-align: center;

    margin-bottom: 60px;
  }


  .faq-header > span {

    color: #b08c4d;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 2px;
  }


  .faq-header h2 {

    margin: 15px 0 0;

    font-family:
      Georgia,
      serif;

    font-size: 50px;

    font-weight: 400;

    letter-spacing: -2px;
  }


  /* =====================================================
     FAQ ITEM
  ====================================================== */

  .faq-list {

    border-top:
      1px solid #d8d1c5;
  }


  .faq-item {

    border-bottom:
      1px solid #d8d1c5;
  }


  .faq-item summary {

    min-height: 90px;

    display: grid;

    grid-template-columns:
      60px 1fr 40px;

    align-items: center;

    gap: 20px;

    cursor: pointer;

    list-style: none;

    user-select: none;
  }


  .faq-item summary::-webkit-details-marker {
    display: none;
  }


  .faq-number {

    color: #b08c4d;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 1px;
  }


  .question {

    color: #0b1f3a;

    font-family:
      Georgia,
      serif;

    font-size: 20px;

    line-height: 1.3;
  }


  .plus {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 30px;

    height: 30px;

    border:
      1px solid #bcb5aa;

    border-radius: 50%;

    color: #0b1f3a;

    font-size: 18px;

    font-weight: 300;

    transition:
      transform .25s ease,
      background .25s ease;
  }


  .faq-item[open] .plus {

    transform: rotate(45deg);

    background: #0b1f3a;

    color: white;
  }


  .answer {

    padding:
      0 60px 35px 80px;
  }


  .answer p {

    max-width: 700px;

    margin: 0;

    color: #777269;

    font-size: 11px;

    line-height: 1.9;
  }


  .answer a {

    display: inline-block;

    margin-top: 18px;

    color: #0b1f3a;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 1.2px;

    text-decoration: none;

    border-bottom:
      1px solid #b08c4d;

    padding-bottom: 5px;
  }


  /* =====================================================
     CTA
  ====================================================== */

  .faq-cta {

    padding: 150px 25px;

    text-align: center;

    background: #0b1f3a;

    color: white;
  }


  .faq-cta > span {

    color: #c7a66b;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 2.5px;
  }


  .faq-cta h2 {

    margin: 20px 0;

    font-family:
      Georgia,
      serif;

    font-size:
      clamp(55px, 7vw, 90px);

    font-weight: 400;

    line-height: .92;

    letter-spacing: -4px;
  }


  .faq-cta p {

    margin: 0 auto 30px;

    color: #c9cbd0;

    font-size: 11px;

    line-height: 1.8;
  }


  .faq-cta a {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    height: 46px;

    padding: 0 25px;

    border:
      1px solid white;

    color: white;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 1.2px;

    text-decoration: none;

    transition: .25s ease;
  }


  .faq-cta a:hover {

    background: white;

    color: #0b1f3a;
  }


  /* =====================================================
     TABLET
  ====================================================== */

  @media (max-width: 900px) {

    .faq-section {

      padding: 110px 25px;
    }

  }


  /* =====================================================
     MOBILE
  ====================================================== */

  @media (max-width: 600px) {

    .faq-hero {

      min-height: 470px;

      padding: 75px 20px;
    }


    .hero-content > span {

      font-size: 7px;

      letter-spacing: 2px;
    }


    .hero-content h1 {

      font-size: 50px;

      letter-spacing: -3px;
    }


    .hero-content p {

      max-width: 310px;

      margin-top: 25px;

      font-size: 10px;
    }


    .faq-section {

      padding: 85px 15px;
    }


    .faq-header {

      margin-bottom: 40px;
    }


    .faq-header h2 {

      font-size: 38px;

      letter-spacing: -1px;
    }


    .faq-item summary {

      min-height: 75px;

      grid-template-columns:
        35px 1fr 32px;

      gap: 10px;
    }


    .faq-number {

      font-size: 7px;
    }


    .question {

      font-size: 16px;
    }


    .plus {

      width: 27px;

      height: 27px;

      font-size: 16px;
    }


    .answer {

      padding:
        0 42px 28px 45px;
    }


    .answer p {

      font-size: 10px;
    }


    .faq-cta {

      padding: 100px 20px;
    }


    .faq-cta h2 {

      font-size: 55px;

      letter-spacing: -3px;
    }


    .faq-cta p {

      font-size: 10px;
    }

  }


  /* =====================================================
     SMALL PHONE
  ====================================================== */

  @media (max-width: 380px) {

    .hero-content h1 {

      font-size: 43px;
    }


    .faq-header h2 {

      font-size: 33px;
    }


    .question {

      font-size: 14px;
    }


    .answer {

      padding-left: 45px;
    }


    .faq-cta h2 {

      font-size: 47px;
    }

  }

</style>
