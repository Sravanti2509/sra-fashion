---

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
export const prerender = false;
 
---

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Forgot Password | SRA</title>
</head>

<body>

  <Header />

  <main class="forgot-page">

```
<section class="forgot-card">

  <div class="forgot-header">

    <span class="eyebrow">
      SRA MEMBERS
    </span>

    <h1>
      Forgot Password?
    </h1>

    <p>
      Enter your email address and we'll send you
      a secure link to reset your password.
    </p>

  </div>

  <div
    id="message"
    class="message"
  ></div>

  <form id="forgotForm">

    <div class="form-group">

      <label for="email">
        EMAIL ADDRESS
      </label>

      <input
        id="email"
        type="email"
        placeholder="Enter your email address"
        autocomplete="email"
        required
      />

    </div>

    <button
      type="submit"
      id="submitButton"
      class="submit-button"
    >
      SEND RESET LINK
    </button>

  </form>

  <div class="back-login">

    <a href="/login">
      ← BACK TO LOGIN
    </a>

  </div>

</section>
```

  </main>

  <Footer />

  <script>

    import { createClient } from "@supabase/supabase-js";

    const supabaseUrl =
      import.meta.env.PUBLIC_SUPABASE_URL;

    const supabaseAnonKey =
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    if (!supabaseUrl || !supabaseAnonKey) {
      console.error(
        "Supabase environment variables are missing."
      );
    }

    const supabase =
      createClient(
        supabaseUrl,
        supabaseAnonKey,
        {
          auth: {
            flowType: "implicit",
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        }
      );

    const form =
      document.querySelector("#forgotForm");

    const emailInput =
      document.querySelector("#email");

    const message =
      document.querySelector("#message");

    const submitButton =
      document.querySelector("#submitButton");

    function showMessage(
      text,
      type = ""
    ) {

      if (!message) return;

      message.textContent = text;

      message.className =
        `message ${type}`;
    }

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();

        const email =
          emailInput?.value
            .trim()
            .toLowerCase() || "";

        const emailPattern =
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!emailPattern.test(email)) {

          showMessage(
            "Please enter a valid email address.",
            "error"
          );

          return;
        }

        if (
          submitButton
          instanceof HTMLButtonElement
        ) {

          submitButton.disabled = true;
          submitButton.textContent = "SENDING...";
        }

        showMessage("", "");

        try {

          /*
           * IMPORTANT:
           * Always use the production reset-password URL.
           */

          const redirectUrl =
            "https://str-fashion.sravanthipuvvala74.workers.dev/reset-password";

          console.log(
            "SUPABASE RESET REDIRECT:",
            redirectUrl
          );

          const {
            error
          } =
            await supabase.auth
              .resetPasswordForEmail(
                email,
                {
                  redirectTo: redirectUrl
                }
              );

          if (error) {

            console.error(
              "RESET EMAIL ERROR:",
              error
            );

            showMessage(
              error.message ||
              "Unable to send reset link.",
              "error"
            );

            if (
              submitButton
              instanceof HTMLButtonElement
            ) {

              submitButton.disabled = false;
              submitButton.textContent =
                "SEND RESET LINK";
            }

            return;
          }

          showMessage(
            "Password reset link has been sent to your email. Please check your inbox.",
            "success"
          );

          if (
            submitButton
            instanceof HTMLButtonElement
          ) {

            submitButton.disabled = true;
            submitButton.textContent =
              "RESET LINK SENT";
          }

        } catch (error) {

          console.error(
            "FORGOT PASSWORD ERROR:",
            error
          );

          showMessage(
            "Something went wrong. Please try again.",
            "error"
          );

          if (
            submitButton
            instanceof HTMLButtonElement
          ) {

            submitButton.disabled = false;
            submitButton.textContent =
              "SEND RESET LINK";
          }
        }

      }
    );

  </script>

</body>

</html>

<style>

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f5f1e8;
  color: #0b1f3a;
  font-family: Arial, Helvetica, sans-serif;
}

.forgot-page {
  min-height: 650px;
  padding: 90px 20px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.forgot-card {
  width: 100%;
  max-width: 500px;
  padding: 45px;
  background: #faf8f3;
  border: 1px solid #ded7cc;
  box-shadow:
    0 20px 60px
    rgba(11, 31, 58, 0.06);
}

.forgot-header {
  text-align: center;
  margin-bottom: 35px;
}

.eyebrow {
  display: block;
  margin-bottom: 13px;
  color: #b79b63;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
}

.forgot-header h1 {
  margin: 0;
  font-family:
    Georgia,
    "Times New Roman",
    serif;
  font-size: 42px;
  font-weight: 400;
  letter-spacing: -1px;
}

.forgot-header p {
  max-width: 360px;
  margin: 15px auto 0;
  color: #777269;
  font-size: 11px;
  line-height: 1.7;
}

.message {
  min-height: 20px;
  margin-bottom: 18px;
  text-align: center;
  font-size: 10px;
  line-height: 1.5;
}

.message.error {
  color: #9f3040;
}

.message.success {
  color: #47704d;
}

.form-group {
  margin-bottom: 22px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  color: #0b1f3a;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

.form-group input {
  width: 100%;
  height: 52px;
  padding: 0 14px;
  border: 1px solid #d4cdc2;
  outline: none;
  background: #ffffff;
  color: #0b1f3a;
  font-size: 12px;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.form-group input::placeholder {
  color: #aaa49c;
}

.form-group input:focus {
  border-color: #0b1f3a;
  box-shadow:
    0 0 0 2px
    rgba(11, 31, 58, 0.05);
}

.submit-button {
  width: 100%;
  height: 53px;
  border: 1px solid #0b1f3a;
  background: #0b1f3a;
  color: #ffffff;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: 0.25s ease;
}

.submit-button:hover {
  background: transparent;
  color: #0b1f3a;
}

.submit-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.back-login {
  margin-top: 25px;
  text-align: center;
}

.back-login a {
  color: #0b1f3a;
  text-decoration: none;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.3px;
}

.back-login a:hover {
  color: #b79b63;
}

@media (max-width: 600px) {

  .forgot-page {
    padding: 55px 14px 70px;
  }

  .forgot-card {
    padding: 30px 22px;
  }

  .forgot-header h1 {
    font-size: 34px;
  }

  .forgot-header p {
    font-size: 10px;
  }
}

@media (max-width: 380px) {

  .forgot-page {
    padding: 40px 10px 60px;
  }

  .forgot-card {
    padding: 25px 17px;
  }

  .forgot-header h1 {
    font-size: 31px;
  }
}

</style>
