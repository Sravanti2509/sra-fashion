---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { shirtsTshirts } from "../data/shirts-t-shirts.js";
import { denim } from "../data/denim.js";
import { trousers } from "../data/trousers.js";
import { shorts } from "../data/shorts.js";

import { dresses } from "../data/dresses.js";
import { jeans } from "../data/jeans.js";
import { tops } from "../data/tops.js";
import { sweaters } from "../data/sweaters-cardigans.js";

const menProducts = [
  ...shirtsTshirts,
  ...denim,
  ...trousers,
  ...shorts,
];

const womenProducts = [
  ...dresses,
  ...jeans,
  ...tops,
  ...sweaters,
];

/* Featured products */
const womenFeature = womenProducts[0];
const menFeature = menProducts[0];
const editorialProduct =
  womenProducts[1] || menProducts[1] || womenFeature || menFeature;
---

<html lang="en" style="color-scheme: only light;">
  <head>
    <meta charset="UTF-8" />
	<meta name="color-scheme" content="only light" />
<meta name="theme-color" content="#ffffff" />
<meta name="supported-color-schemes" content="light" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="SRA — Timeless fashion. Modern perspective. Yours."
    />

    <title>SRA | Timeless. Modern. Yours.</title>
  </head>

  <body>

    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="hero">

        <div class="hero-inner">

          <span class="hero-label">
            SRA FASHION
          </span>

          <h1>
            Timeless.<br />
            Modern.<br />
            Yours.
          </h1>

          <p class="hero-description">
            Thoughtfully designed pieces for
            the way you live, move and express yourself.
          </p>

          <div class="hero-actions">

            <a
              href="/women"
              class="hero-button dark"
            >
              SHOP WOMEN
            </a>

            <a
              href="/men"
              class="hero-button outline"
            >
              SHOP MEN
            </a>

          </div>

        </div>

        <div class="hero-scroll">
          <span>SCROLL TO EXPLORE</span>
          <span class="scroll-line"></span>
        </div>

      </section>


      <!-- =====================================================
           INTRODUCTION
      ====================================================== -->

      <section class="intro-section">

        <div class="intro-label">
          THE SRA COLLECTION
        </div>

        <h2>
          Refined pieces for<br />
          modern everyday dressing.
        </h2>

        <p>
          SRA brings together timeless silhouettes,
          considered details and effortless style.
          Created for those who believe what they wear
          should feel as personal as who they are.
        </p>

      </section>


      <!-- =====================================================
           MEN / WOMEN FEATURE
      ====================================================== -->

      <section class="collection-feature">

        <!-- WOMEN -->

        <a
          href="/women"
          class="collection-card"
        >

          <div class="collection-image">

            {
              womenFeature && (
                <img
                  src={womenFeature.image}
                  alt={womenFeature.name}
                />
              )
            }

            <div class="image-overlay"></div>

            <div class="collection-content">

              <span>
                SRA WOMEN
              </span>

              <h3>
                Modern<br />
                femininity.
              </h3>

              <strong>
                EXPLORE WOMEN →
              </strong>

            </div>

          </div>

        </a>


        <!-- MEN -->

        <a
          href="/men"
          class="collection-card"
        >

          <div class="collection-image">

            {
              menFeature && (
                <img
                  src={menFeature.image}
                  alt={menFeature.name}
                />
              )
            }

            <div class="image-overlay"></div>

            <div class="collection-content">

              <span>
                SRA MEN
              </span>

              <h3>
                Quiet<br />
                confidence.
              </h3>

              <strong>
                EXPLORE MEN →
              </strong>

            </div>

          </div>

        </a>

      </section>


      <!-- =====================================================
           EDITORIAL
      ====================================================== -->

      <section class="editorial-section">

        <div class="editorial-image">

          {
            editorialProduct && (
              <img
                src={editorialProduct.image}
                alt={editorialProduct.name}
                loading="lazy"
              />
            )
          }

        </div>


        <div class="editorial-content">

          <span>
            THE SRA EDIT
          </span>

          <h2>
            Designed for<br />
            effortless confidence.
          </h2>

          <p>
            From everyday essentials to statement
            pieces, every SRA design is made to move
            effortlessly through your wardrobe.
          </p>

          <a
            href="/women"
            class="editorial-button"
          >
            DISCOVER THE COLLECTION
          </a>

        </div>

      </section>


      <!-- =====================================================
           BRAND STATEMENT
      ====================================================== -->

      <section class="statement-section">

        <span>
          SRA COLLECTION
        </span>

        <h2>
          Wear your<br />
          confidence.
        </h2>

        <p>
          Timeless pieces. Modern perspective.
          A wardrobe that feels entirely yours.
        </p>

      </section>

    </main>


    <Footer />


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

      /* =========================================
         FAVOURITES
      ========================================= */

      function getFavourites() {

        try {

          const saved =
            JSON.parse(
              localStorage.getItem(
                "sra-favourites"
              ) || "[]"
            );

          return Array.isArray(saved)
            ? saved.map(String)
            : [];

        } catch {

          return [];

        }

      }


      function updateWishlistButtons() {

        const favourites =
          getFavourites();

        document
          .querySelectorAll(".wishlist-button")
          .forEach((button) => {

            const id =
              String(
                button.dataset.productId
              );

            if (
              favourites.includes(id)
            ) {

              button.textContent = "♥";

              button.classList.add(
                "active"
              );

            } else {

              button.textContent = "♡";

              button.classList.remove(
                "active"
              );

            }

          });

      }


      document
        .querySelectorAll(".wishlist-button")
        .forEach((button) => {

          button.addEventListener(
            "click",
            () => {

              const id =
                String(
                  button.dataset.productId
                );

              let favourites =
                getFavourites();


              if (
                favourites.includes(id)
              ) {

                favourites =
                  favourites.filter(
                    (item) => item !== id
                  );

              } else {

                favourites.push(id);

              }


              localStorage.setItem(
                "sra-favourites",
                JSON.stringify(favourites)
              );


              updateWishlistButtons();


              window.dispatchEvent(
                new Event(
                  "favouritesUpdated"
                )
              );

            }
          );

        });


      updateWishlistButtons();

    </script>

  </body>
</html>


<style>

/* =====================================================
   RESET
===================================================== */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: #f6f2e9 !important;
  color-scheme: only light !important;
}

body {
  margin: 0;
  background: #f6f2e9 !important;
  color: #0b1f3a !important;
  color-scheme: only light !important;
}

a {
