---
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

import { shirtsTshirts } from "../../../data/shirts-t-shirts.js";
import { denim } from "../../../data/denim.js";
import { trousers } from "../../../data/trousers.js";
import { shorts } from "../../../data/shorts.js";
import { dresses } from "../../../data/dresses.js";
import { jeans } from "../../../data/jeans.js";
import { tops } from "../../../data/tops.js";
import { sweaters } from "../../../data/sweaters-cardigans.js";

const allProducts = [
  ...shirtsTshirts,
  ...denim,
  ...trousers,
  ...shorts,
  ...dresses,
  ...jeans,
  ...tops,
  ...sweaters,
];

export function getStaticPaths() {
  return allProducts.map((product) => ({
    params: {
      id: String(product.id),
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>{product.name} | SRA</title>
</head>

<body>

  <Header />

  <main class="product-page">

    <!-- BREADCRUMB -->
    <div class="breadcrumb">
      <a href="/men">SHOP</a>
      <span>/</span>
      <span>{product.name}</span>
    </div>


    <!-- PRODUCT -->
    <section class="product-section">

      <!-- LEFT IMAGE -->
      <div class="product-image-area">

        <div class="image-card">

          <img
            src={product.image}
            alt={product.name}
          />

        </div>

        <button
          id="wishlistButton"
          class="wishlist"
          type="button"
          aria-label="Add to favourites"
        >
          ♡
        </button>

      </div>


      <!-- RIGHT DETAILS -->
      <div class="product-info">

        <div class="product-label">
          SRA COLLECTION
        </div>

        <h1>
          {product.name}
        </h1>

        <div class="price">
          ₹{Number(product.price).toLocaleString("en-IN")}
        </div>

        <div class="line"></div>

        <p class="description">
          {product.description ||
            "A refined wardrobe essential designed with timeless style, premium comfort and effortless everyday elegance."}
        </p>


        <!-- SIZE -->
        <div class="size-section">

          <div class="size-title">
            <span>SELECT SIZE</span>
            <span class="size-guide">SIZE GUIDE</span>
          </div>

          <div class="size-list">

            {
              (product.sizes || ["XS", "S", "M", "L", "XL"]).map(
                (size) => (
                  <button
                    type="button"
                    class="size-button"
                    data-size={size}
                  >
                    {size}
                  </button>
                )
              )
            }

          </div>

        </div>


        <!-- CART -->
        <button
          type="button"
          class="add-cart"
          id="addCart"
        >
          ADD TO CART
        </button>


        <!-- INFORMATION -->
        <div class="product-information">

          <div class="info-row">
            <span>DELIVERY</span>
            <span>Complimentary delivery</span>
          </div>

          <div class="info-row">
            <span>RETURNS</span>
            <span>Easy returns within 14 days</span>
          </div>

          <div class="info-row">
            <span>AVAILABILITY</span>
            <span>In stock</span>
          </div>

        </div>

      </div>

    </section>


    <!-- BOTTOM BRAND SECTION -->
    <section class="brand-section">

      <span>SRA COLLECTION</span>

      <h2>
        Designed for<br />
        effortless confidence.
      </h2>

      <p>
        Timeless pieces made to become part of your everyday wardrobe.
      </p>

    </section>

  </main>


  <Footer />


  <script define:vars={{ productId: String(product.id) }}>

    /* ================================
       SIZE
    ================================= */

    const sizeButtons =
      document.querySelectorAll(".size-button");

    let selectedSize = "";

    sizeButtons.forEach((button) => {

      button.addEventListener("click", () => {

        sizeButtons.forEach((item) => {
          item.classList.remove("selected");
        });

        button.classList.add("selected");

        selectedSize =
          button.dataset.size || "";

      });

    });


    /* ================================
       FAVOURITES
    ================================= */

    const wishlistButton =
      document.querySelector("#wishlistButton");

    function getFavourites() {

      try {

        const saved =
          JSON.parse(
            localStorage.getItem("sra-favourites") || "[]"
          );

        return Array.isArray(saved)
          ? saved.map(String)
          : [];

      } catch {

        return [];

      }

    }


    let favourites =
      getFavourites();


    function updateWishlist() {

      if (!wishlistButton) return;

      if (
        favourites.includes(productId)
      ) {

        wishlistButton.textContent = "♥";

        wishlistButton.classList.add(
          "active"
        );

        wishlistButton.setAttribute(
          "aria-label",
          "Remove from favourites"
        );

      } else {

        wishlistButton.textContent = "♡";

        wishlistButton.classList.remove(
          "active"
        );

        wishlistButton.setAttribute(
          "aria-label",
          "Add to favourites"
        );

      }

    }


    updateWishlist();


    wishlistButton?.addEventListener(
      "click",
      () => {

        favourites =
          getFavourites();

        if (
          favourites.includes(productId)
        ) {

          favourites =
            favourites.filter(
              (id) => id !== productId
            );

        } else {

          favourites.push(productId);

        }


        localStorage.setItem(
          "sra-favourites",
          JSON.stringify(favourites)
        );


        updateWishlist();


        window.dispatchEvent(
          new Event("favouritesUpdated")
        );

      }
    );


    /* ================================
       ADD TO CART
    ================================= */

    const addCart =
      document.querySelector("#addCart");


    addCart?.addEventListener(
      "click",
      () => {

        if (!selectedSize) {

          alert(
            "Please select a size first."
          );

          return;

        }


        let cart = [];

        try {

          cart =
            JSON.parse(
              localStorage.getItem("sra-cart") || "[]"
            );

          if (!Array.isArray(cart)) {
            cart = [];
          }

        } catch {

          cart = [];

        }


        const existing =
          cart.find(
            (item) =>
              String(item.id) === productId &&
              item.size === selectedSize
          );


        if (existing) {

          existing.quantity =
            Number(existing.quantity || 0) + 1;

        } else {

          cart.push({

            id: productId,

            size: selectedSize,

            quantity: 1

          });

        }


        localStorage.setItem(
  "sra-cart",
  JSON.stringify(cart)
);


/* Update header cart count immediately */
window.dispatchEvent(
  new Event("cartUpdated")
);


addCart.textContent =
  "ADDED TO CART ✓";

        addCart.classList.add(
          "added"
        );


        setTimeout(() => {

          addCart.textContent =
            "ADD TO CART";

          addCart.classList.remove(
            "added"
          );

        }, 1800);

      }
    );

  </script>

</body>
</html>


<style>

/* =========================================
   RESET
========================================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f5f1e8;
  color: #0b1f3a;
  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


/* =========================================
   PAGE
========================================= */

.product-page {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;

  padding:
    35px 42px 120px;
}


/* =========================================
   BREADCRUMB
========================================= */

.breadcrumb {
  display: flex;
  align-items: center;

  gap: 10px;

  margin-bottom: 32px;

  color: #8a857c;

  font-size: 8px;

  letter-spacing: 1.4px;

  text-transform: uppercase;
}

.breadcrumb a {
  color: #0b1f3a;

  text-decoration: none;

  font-weight: 700;
}

.breadcrumb span:last-child {
  max-width: 350px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


/* =========================================
   PRODUCT SECTION
========================================= */

.product-section {
  display: grid;

  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(400px, 0.92fr);

  gap: 80px;

  align-items: start;
}


/* =========================================
   IMAGE AREA
========================================= */

.product-image-area {
  position: relative;

  width: 100%;

  min-width: 0;
}


/* =========================================
   IMAGE CARD
========================================= */

.image-card {
  width: 100%;

  height: 720px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #ebe6dd;

  overflow: hidden;
}

.image-card img {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: contain;

  object-position: center;

  transition:
    transform .5s ease;
}

.image-card:hover img {
  transform: scale(1.015);
}


/* =========================================
   WISHLIST
========================================= */

.wishlist {
  position: absolute;

  top: 18px;

  right: 18px;

  width: 46px;

  height: 46px;

  padding: 0;

  border: none;

  border-radius: 50%;

  background:
    rgba(255, 255, 255, .96);

  color: #0b1f3a;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 23px;

  line-height: 1;

  cursor: pointer;

  box-shadow:
    0 5px 18px
    rgba(0, 0, 0, .10);

  transition:
    transform .2s ease;
}

.wishlist:hover {
  transform: scale(1.06);
}

.wishlist.active {
  color: #9f3040;
}


/* =========================================
   PRODUCT INFO
========================================= */

.product-info {
  position: sticky;

  top: 100px;

  padding:
    30px 20px 30px 0;
}


/* =========================================
   LABEL
========================================= */

.product-label {
  color: #b89b61;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 2px;
}


/* =========================================
   TITLE
========================================= */

.product-info h1 {
  margin:
    17px 0 14px;

  max-width: 580px;

  color: #0b1f3a;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 50px;

  font-weight: 400;

  line-height: 1.05;

  letter-spacing: -2px;
}


/* =========================================
   PRICE
========================================= */

.price {
  color: #0b1f3a;

  font-size: 16px;

  font-weight: 600;
}


/* =========================================
   DIVIDER
========================================= */

.line {
  width: 100%;

  height: 1px;

  margin:
    28px 0;

  background: #ddd7cd;
}


/* =========================================
   DESCRIPTION
========================================= */

.description {
  max-width: 510px;

  margin:
    0 0 34px;

  color: #777269;

  font-size: 13px;

  line-height: 1.8;
}


/* =========================================
   SIZE
========================================= */

.size-section {
  margin-bottom: 28px;
}

.size-title {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 12px;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 1.3px;
}

.size-guide {
  color: #8a857c;

  text-decoration: underline;

  cursor: pointer;
}

.size-list {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}

.size-button {
  width: 52px;

  height: 44px;

  padding: 0;

  border:
    1px solid #d4cec3;

  background:
    transparent;

  color: #0b1f3a;

  font-size: 9px;

  cursor: pointer;

  transition:
    all .2s ease;
}

.size-button:hover,
.size-button.selected {
  border-color: #0b1f3a;

  background: #0b1f3a;

  color: #fff;
}


/* =========================================
   ADD CART
========================================= */

.add-cart {
  width: 100%;

  height: 56px;

  border:
    1px solid #0b1f3a;

  background: #0b1f3a;

  color: #fff;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 1.5px;

  cursor: pointer;

  transition:
    all .25s ease;
}

.add-cart:hover {
  background:
    transparent;

  color:
    #0b1f3a;
}

.add-cart.added {
  background:
    #314b3a;

  border-color:
    #314b3a;
}


/* =========================================
   INFORMATION
========================================= */

.product-information {
  margin-top: 35px;

  border-top:
    1px solid #ddd7cd;
}

.info-row {
  min-height: 57px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 25px;

  border-bottom:
    1px solid #ddd7cd;

  font-size: 9px;
}

.info-row span:first-child {
  color: #0b1f3a;

  font-weight: 700;

  letter-spacing: 1px;
}

.info-row span:last-child {
  color: #777269;

  text-align: right;
}


/* =========================================
   BRAND SECTION
========================================= */

.brand-section {
  padding:
    160px 20px 30px;

  text-align: center;
}

.brand-section > span {
  color: #b89b61;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 2px;
}

.brand-section h2 {
  margin:
    18px 0 16px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 54px;

  font-weight: 400;

  line-height: 1.05;

  letter-spacing: -2px;
}

.brand-section p {
  margin: 0;

  color: #777269;

  font-size: 11px;
}


/* =========================================
   LAPTOP
========================================= */

@media (max-width: 1100px) {

  .product-page {
    padding:
      30px 28px 90px;
  }

  .product-section {
    gap: 50px;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(350px, .85fr);
  }

  .image-card {
    height: 620px;
  }

  .product-info h1 {
    font-size: 43px;
  }

}


/* =========================================
   TABLET
========================================= */

@media (max-width: 850px) {

  .product-page {
    padding:
      25px 20px 80px;
  }

  .product-section {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .product-info {
    position: static;

    padding:
      10px 0 20px;
  }

  .image-card {
    height: 650px;
  }

  .product-info h1 {
    max-width: 700px;

    font-size: 45px;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {

  body {
    overflow-x: hidden;
  }


  .product-page {
    width: 100%;

    padding:
      20px 12px 60px;
  }


  /* BREADCRUMB */

  .breadcrumb {
    margin-bottom: 18px;

    gap: 7px;

    font-size: 6.5px;

    letter-spacing: 1px;
  }


  .breadcrumb span:last-child {
    max-width: 190px;
  }


  /* PRODUCT */

  .product-section {
    display: flex;

    flex-direction: column;

    gap: 0;

    width: 100%;
  }


  /* IMAGE */

  .product-image-area {
    width: 100%;
  }


  .image-card {
    width: 100%;

    height: auto;

    aspect-ratio: 3 / 4;

    background: #ebe6dd;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;
  }


  .image-card img {
    width: 100%;

    height: 100%;

    object-fit: contain;

    object-position: center;

    transform: none;
  }


  .image-card:hover img {
    transform: none;
  }


  /* HEART */

  .wishlist {
    top: 10px;

    right: 10px;

    width: 38px;

    height: 38px;

    font-size: 19px;
  }


  /* DETAILS */

  .product-info {
    width: 100%;

    padding:
      28px 2px 0;

    position: static;
  }


  .product-label {
    font-size: 7px;

    letter-spacing: 1.5px;
  }


  .product-info h1 {
    width: 100%;

    max-width: none;

    margin:
      11px 0 10px;

    font-size: 30px;

    line-height: 1.08;

    letter-spacing: -1px;
  }


  .price {
    font-size: 13px;
  }


  .line {
    margin:
      20px 0;
  }


  .description {
    width: 100%;

    max-width: none;

    margin-bottom: 25px;

    font-size: 10.5px;

    line-height: 1.7;
  }


  /* SIZE */

  .size-section {
    margin-bottom: 22px;
  }


  .size-title {
    margin-bottom: 10px;

    font-size: 7px;

    letter-spacing: 1px;
  }


  .size-list {
    gap: 6px;
  }


  .size-button {
    width: 43px;

    height: 39px;

    font-size: 8px;
  }


  /* CART */

  .add-cart {
    width: 100%;

    height: 50px;

    font-size: 8px;

    letter-spacing: 1.2px;
  }


  /* INFO */

  .product-information {
    margin-top: 25px;
  }


  .info-row {
    min-height: 50px;

    gap: 15px;

    font-size: 7.5px;
  }


  .info-row span:last-child {
    max-width: 180px;
  }


  /* BRAND */

  .brand-section {
    padding:
      80px 8px 20px;
  }


  .brand-section > span {
    font-size: 7px;

    letter-spacing: 1.5px;
  }


  .brand-section h2 {
    margin:
      14px 0 12px;

    font-size: 34px;

    line-height: 1.08;

    letter-spacing: -1px;
  }


  .brand-section p {
    font-size: 9px;

    line-height: 1.6;
  }

}


/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 380px) {

  .product-page {
    padding:
      17px 10px 50px;
  }


  .image-card {
    aspect-ratio: 0.78;
  }


  .wishlist {
    top: 8px;

    right: 8px;

    width: 35px;

    height: 35px;

    font-size: 18px;
  }


  .product-info {
    padding-top: 24px;
  }


  .product-info h1 {
    font-size: 27px;

    letter-spacing: -.8px;
  }


  .description {
    font-size: 10px;
  }


  .size-button {
    width: 40px;

    height: 37px;
  }


  .add-cart {
    height: 48px;
  }


  .brand-section h2 {
    font-size: 30px;
  }

}

</style>