---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders | SRA</title>
</head>

<body>
  <Header />

  <main class="orders-page">
    <div class="orders-container">

      <!-- HEADER -->
      <header class="orders-header">
        <div class="eyebrow">SRA COLLECTION</div>

        <h1>My Orders</h1>

        <p>
          View your recent orders and order status.
        </p>
      </header>

      <!-- MESSAGE -->
      <div id="ordersMessage" class="orders-message">
        Loading your orders...
      </div>

      <!-- ORDERS -->
      <div id="ordersList" class="orders-list"></div>

    </div>
  </main>

  <Footer />


  <script>
    import { createClient } from "@supabase/supabase-js";

    const supabaseUrl =
      import.meta.env.PUBLIC_SUPABASE_URL;

    const supabaseAnonKey =
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    const supabase = createClient(
      supabaseUrl,
      supabaseAnonKey,
      {
        auth: {
          persistSession: true,
          autoRefreshToken: true,
          detectSessionInUrl: true
        }
      }
    );


    const ordersList =
      document.querySelector("#ordersList");

    const ordersMessage =
      document.querySelector("#ordersMessage");


    /* =====================================================
       HELPERS
    ===================================================== */

    function formatPrice(price) {
      return (
        "₹" +
        Number(price || 0).toLocaleString("en-IN")
      );
    }


    function formatDate(dateValue) {
      if (!dateValue) {
        return "Date unavailable";
      }

      const date = new Date(dateValue);

      return date.toLocaleDateString(
        "en-IN",
        {
          day: "2-digit",
          month: "short",
          year: "numeric"
        }
      );
    }


    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }


    function getStatusClass(status) {
      const value =
        String(status || "")
          .toLowerCase();

      if (value === "delivered") {
        return "delivered";
      }

      if (
        value === "cancelled" ||
        value === "canceled"
      ) {
        return "cancelled";
      }

      if (value === "shipped") {
        return "shipped";
      }

      return "confirmed";
    }


    /* =====================================================
       AUTH
    ===================================================== */

    async function getCurrentUser() {
      try {

        const {
          data,
          error
        } =
          await supabase.auth.getSession();

        if (error) {
          console.error(
            "SESSION ERROR:",
            error
          );

          return null;
        }

        return data?.session?.user || null;

      } catch (error) {

        console.error(
          "AUTH ERROR:",
          error
        );

        return null;
      }
    }


    /* =====================================================
       LOGIN
    ===================================================== */

    function showLoginMessage() {

      ordersMessage.textContent =
        "Please login to view your orders.";

      ordersMessage.className =
        "orders-message error";


      ordersList.innerHTML = `
        <div class="empty-orders">

          <div class="empty-icon">
            ♡
          </div>

          <h2>Login Required</h2>

          <p>
            Please login to view your order history.
          </p>

          <a
            href="/login"
            class="login-button"
          >
            LOGIN
          </a>

        </div>
      `;
    }


    /* =====================================================
       EMPTY ORDERS
    ===================================================== */

    function showEmptyOrders() {

      ordersMessage.textContent = "";

      ordersMessage.className =
        "orders-message";


      ordersList.innerHTML = `
        <div class="empty-orders">

          <div class="empty-icon">
            ♡
          </div>

          <h2>No Orders Yet</h2>

          <p>
            Your orders will appear here after you place an order.
          </p>

          <a
            href="/"
            class="login-button"
          >
            START SHOPPING
          </a>

        </div>
      `;
    }


    /* =====================================================
       CANCEL ORDER
    ===================================================== */

    async function cancelOrder(orderId) {

      const confirmed =
        window.confirm(
          "Are you sure you want to cancel this order?"
        );

      if (!confirmed) {
        return;
      }


      try {

        ordersMessage.textContent =
          "Cancelling your order...";

        ordersMessage.className =
          "orders-message";


        const user =
          await getCurrentUser();


        if (!user) {
          showLoginMessage();
          return;
        }


        /* Get order number */

        const {
          data: order,
          error: orderError
        } =
          await supabase
            .from("orders")
            .select("order_number")
            .eq("id", orderId)
            .eq("user_id", user.id)
            .maybeSingle();


        if (orderError) {

          console.error(
            "ORDER FETCH ERROR:",
            orderError
          );

          ordersMessage.textContent =
            orderError.message ||
            "Unable to find this order.";

          ordersMessage.className =
            "orders-message error";

          return;
        }


        if (!order) {

          ordersMessage.textContent =
            "Order not found.";

          ordersMessage.className =
            "orders-message error";

          return;
        }


        /* Cancel through Edge Function */

        const {
          data,
          error
        } =
          await supabase.functions.invoke(
            "cancel-order",
            {
              body: {
                orderNumber:
                  order.order_number,

                userId:
                  user.id
              }
            }
          );


        if (error) {

          console.error(
            "CANCEL FUNCTION ERROR:",
            error
          );

          ordersMessage.textContent =
            error.message ||
            "Unable to cancel your order.";

          ordersMessage.className =
            "orders-message error";

          return;
        }


        if (!data?.success) {

          ordersMessage.textContent =
            data?.error ||
            "Unable to cancel your order.";

          ordersMessage.className =
            "orders-message error";

          return;
        }


        ordersMessage.textContent =
          "Order cancelled successfully.";

        ordersMessage.className =
          "orders-message success";


        await loadOrders();

      } catch (error) {

        console.error(
          "CANCEL ERROR:",
          error
        );

        ordersMessage.textContent =
          "Something went wrong while cancelling the order.";

        ordersMessage.className =
          "orders-message error";
      }
    }


    /* =====================================================
       DISPLAY ORDERS
    ===================================================== */

    function displayOrders(orders) {

      ordersMessage.textContent =
        `${orders.length} ${
          orders.length === 1
            ? "order"
            : "orders"
        }`;

      ordersMessage.className =
        "orders-message";


      ordersList.innerHTML =
        orders
          .map((order) => {

            const paymentMethod =
              String(
                order.payment_method || ""
              ).toUpperCase();


            const paymentStatus =
              String(
                order.payment_status ||
                "pending"
              );


            const orderStatus =
              String(
                order.order_status ||
                "confirmed"
              );


            const normalizedStatus =
              orderStatus.toLowerCase();


            const canCancel =
              normalizedStatus ===
              "confirmed";


            return `

              <article class="order-card">

                <!-- TOP -->
                <div class="card-top">

                  <div class="order-main">

                    <span class="small-label">
                      ORDER NUMBER
                    </span>

                    <div class="order-number">
                      ${escapeHtml(
                        order.order_number
                      )}
                    </div>

                  </div>


                  <div class="card-right">

                    <span class="small-label">
                      ORDER DATE
                    </span>

                    <div class="order-date">
                      ${formatDate(
                        order.created_at
                      )}
                    </div>

                  </div>

                </div>


                <!-- STATUS -->
                <div class="status-row">

                  <span
                    class="status ${getStatusClass(
                      orderStatus
                    )}"
                  >
                    ${escapeHtml(
                      orderStatus
                    )}
                  </span>

                </div>


                <!-- DETAILS -->
                <div class="order-details">

                  <div class="detail">

                    <span class="detail-label">
                      TOTAL
                    </span>

                    <strong>
                      ${formatPrice(
                        order.total
                      )}
                    </strong>

                  </div>


                  <div class="detail">

                    <span class="detail-label">
                      PAYMENT
                    </span>

                    <strong>
                      ${escapeHtml(
                        paymentMethod ||
                        "N/A"
                      )}
                    </strong>

                  </div>


                  <div class="detail">

                    <span class="detail-label">
                      PAYMENT STATUS
                    </span>

                    <strong class="payment-status">
                      ${escapeHtml(
                        paymentStatus
                      )}
                    </strong>

                  </div>

                </div>


                <!-- DELIVERY -->
                <div class="delivery">

                  <div class="delivery-title">
                    <span>
                      DELIVERY DETAILS
                    </span>

                    <span class="delivery-line"></span>
                  </div>


                  <div class="delivery-content">

                    <div class="customer-name">
                      ${escapeHtml(
                        order.customer_name
                      )}
                    </div>

                    <div class="address">
                      ${escapeHtml(
                        order.delivery_address
                      )}
                    </div>

                    <div class="location">
                      ${escapeHtml(
                        order.city
                      )}

                      <span>•</span>

                      ${escapeHtml(
                        order.pincode
                      )}
                    </div>

                  </div>

                </div>


                ${
                  canCancel
                    ? `
                      <div class="card-bottom">

                        <button
                          type="button"
                          class="cancel-button"
                          data-order-id="${escapeHtml(
                            order.id
                          )}"
                        >
                          CANCEL ORDER
                        </button>

                      </div>
                    `
                    : ""
                }

              </article>

            `;
          })
          .join("");


      /* =====================================================
         CANCEL BUTTON EVENTS
      ===================================================== */

      document
        .querySelectorAll(".cancel-button")
        .forEach((button) => {

          button.addEventListener(
            "click",
            async () => {

              const orderId =
                button.dataset.orderId;


              if (!orderId) {
                return;
              }


              button.disabled =
                true;

              button.textContent =
                "CANCELLING...";


              await cancelOrder(
                orderId
              );
            }
          );
        });
    }


    /* =====================================================
       LOAD ORDERS
    ===================================================== */

    async function loadOrders() {

      const user =
        await getCurrentUser();


      console.log(
        "ORDER HISTORY USER:",
        user
      );


      if (!user) {
        showLoginMessage();
        return;
      }


      const {
        data: orders,
        error
      } =
        await supabase
          .from("orders")
          .select("*")
          .eq(
            "user_id",
            user.id
          )
          .order(
            "created_at",
            {
              ascending: false
            }
          );


      if (error) {

        console.error(
          "ORDERS FETCH ERROR:",
          error
        );

        ordersMessage.textContent =
          error.message ||
          "Unable to load your orders.";

        ordersMessage.className =
          "orders-message error";

        return;
      }


      console.log(
        "MY ORDERS:",
        orders
      );


      if (
        !orders ||
        !orders.length
      ) {

        showEmptyOrders();

        return;
      }


      displayOrders(
        orders
      );
    }


    loadOrders();

  </script>
</body>
</html>


<style is:global>

/* =====================================================
   SRA — PREMIUM MY ORDERS
===================================================== */

* {
  box-sizing: border-box;
}


body {
  margin: 0;

  background:
    #f7f6f2;

  color:
    #0b1f3a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


/* =====================================================
   PAGE
===================================================== */

.orders-page {

  min-height:
    calc(100vh - 76px);

  padding:
    78px 24px 120px;
}


.orders-container {

  width:
    100%;

  max-width:
    1050px;

  margin:
    0 auto;
}


/* =====================================================
   HEADER
===================================================== */

.orders-header {

  text-align:
    center;

  margin-bottom:
    48px;
}


.eyebrow {

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    3px;

  margin-bottom:
    15px;
}


.orders-header h1 {

  margin:
    0;

  color:
    #0b1f3a;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    50px;

  font-weight:
    400;

  letter-spacing:
    -1px;
}


.orders-header p {

  margin:
    14px 0 0;

  color:
    #8a857c;

  font-size:
    11px;

  letter-spacing:
    .3px;
}


/* =====================================================
   MESSAGE
===================================================== */

.orders-message {

  min-height:
    18px;

  margin-bottom:
    24px;

  color:
    #8a857c;

  font-size:
    10px;

  text-align:
    center;
}


.orders-message.error {
  color:
    #a13b46;
}


.orders-message.success {
  color:
    #41624a;
}


/* =====================================================
   LIST
===================================================== */

.orders-list {

  display:
    flex;

  flex-direction:
    column;

  gap:
    18px;
}


/* =====================================================
   CARD
===================================================== */

.order-card {

  background:
    #ffffff;

  border:
    1px solid #e6e1d8;

  padding:
    28px 32px;

  transition:
    .25s ease;
}


.order-card:hover {

  border-color:
    #d5ccbc;

  box-shadow:
    0 15px 40px
    rgba(11, 31, 58, .06);

  transform:
    translateY(-2px);
}


/* =====================================================
   TOP
===================================================== */

.card-top {

  display:
    flex;

  justify-content:
    space-between;

  align-items:
    flex-start;

  gap:
    30px;
}


.order-main,
.card-right {

  display:
    flex;

  flex-direction:
    column;

  gap:
    7px;
}


.card-right {

  text-align:
    right;
}


.small-label {

  color:
    #b08c4d;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    2px;
}


.order-number {

  color:
    #0b1f3a;

  font-size:
    14px;

  font-weight:
    600;

  letter-spacing:
    .7px;
}


.order-date {

  color:
    #777269;

  font-size:
    10px;
}


/* =====================================================
   STATUS
===================================================== */

.status-row {

  margin-top:
    18px;
}


.status {

  display:
    inline-flex;

  align-items:
    center;

  min-height:
    25px;

  padding:
    0 11px;

  border:
    1px solid;

  font-size:
    7px !important;

  font-weight:
    700 !important;

  letter-spacing:
    1.2px;

  text-transform:
    uppercase;
}


.status.confirmed {

  color:
    #41624a;

  background:
    #f2f7f3;

  border-color:
    #d5e4d8;
}


.status.shipped {

  color:
    #53627b;

  background:
    #f3f5f8;

  border-color:
    #dce1e8;
}


.status.delivered {

  color:
    #41624a;

  background:
    #edf6ef;

  border-color:
    #d2e4d5;
}


.status.cancelled {

  color:
    #9c3945;

  background:
    #faf0f2;

  border-color:
    #ead4d8;
}


/* =====================================================
   DETAILS
===================================================== */

.order-details {

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap:
    0;

  margin-top:
    25px;

  padding:
    22px 0;

  border-top:
    1px solid #eeeae3;

  border-bottom:
    1px solid #eeeae3;
}


.detail {

  display:
    flex;

  flex-direction:
    column;

  gap:
    8px;

  padding:
    0 25px;

  border-right:
    1px solid #eeeae3;
}


.detail:first-child {
  padding-left:
    0;
}


.detail:last-child {

  border-right:
    none;

  padding-right:
    0;
}


.detail-label {

  color:
    #b08c4d;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.8px;
}


.detail strong {

  color:
    #0b1f3a;

  font-size:
    12px;

  font-weight:
    600;

  letter-spacing:
    .4px;
}


.payment-status {

  text-transform:
    capitalize;

  color:
    #777269 !important;

  font-weight:
    500 !important;
}


/* =====================================================
   DELIVERY
===================================================== */

.delivery {

  padding-top:
    22px;
}


.delivery-title {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  color:
    #b08c4d;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.8px;
}


.delivery-line {

  flex:
    1;

  height:
    1px;

  background:
    #eeeae3;
}


.delivery-content {

  margin-top:
    13px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    5px;
}


.customer-name {

  color:
    #0b1f3a;

  font-size:
    11px;

  font-weight:
    600;
}


.address {

  max-width:
    700px;

  color:
    #777269;

  font-size:
    10px;

  line-height:
    1.6;
}


.location {

  color:
    #8a857c;

  font-size:
    9px;
}


.location span {

  margin:
    0 5px;

  color:
    #b08c4d;
}


/* =====================================================
   BOTTOM
===================================================== */

.card-bottom {

  display:
    flex;

  justify-content:
    flex-end;

  margin-top:
    22px;

  padding-top:
    18px;

  border-top:
    1px solid #eeeae3;
}


.cancel-button {

  height:
    38px;

  min-width:
    145px;

  padding:
    0 20px;

  border:
    1px solid #a13b46;

  background:
    transparent;

  color:
    #a13b46;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.4px;

  cursor:
    pointer;

  transition:
    .25s ease;
}


.cancel-button:hover {

  background:
    #a13b46;

  color:
    #ffffff;
}


.cancel-button:disabled {

  opacity:
    .5;

  cursor:
    not-allowed;
}


/* =====================================================
   EMPTY
===================================================== */

.empty-orders {

  background:
    #ffffff;

  border:
    1px solid #e4e0d8;

  padding:
    85px 30px;

  text-align:
    center;
}


.empty-icon {

  width:
    52px;

  height:
    52px;

  margin:
    0 auto 23px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border:
    1px solid #d8d0c2;

  color:
    #b08c4d;

  font-family:
    Georgia,
    serif;

  font-size:
    21px;
}


.empty-orders h2 {

  margin:
    0 0 12px;

  color:
    #0b1f3a;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    30px;

  font-weight:
    400;
}


.empty-orders p {

  max-width:
    410px;

  margin:
    0 auto 28px;

  color:
    #777269;

  font-size:
    10px;

  line-height:
    1.8;
}


.login-button {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  min-width:
    155px;

  height:
    45px;

  padding:
    0 22px;

  background:
    #0b1f3a;

  color:
    #ffffff;

  text-decoration:
    none;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    1.5px;

  transition:
    .25s ease;
}


.login-button:hover {

  background:
    #b08c4d;
}


/* =====================================================
   TABLET / MOBILE
===================================================== */

@media (max-width: 700px) {

  .orders-page {

    padding:
      48px 14px 80px;
  }


  .orders-header {

    margin-bottom:
      35px;
  }


  .orders-header h1 {

    font-size:
      38px;
  }


  .orders-header p {

    font-size:
      10px;
  }


  .orders-list {

    gap:
      14px;
  }


  .order-card {

    padding:
      21px 18px;
  }


  .order-card:hover {

    transform:
      none;

    box-shadow:
      none;
  }


  .card-top {

    gap:
      15px;
  }


  .order-number {

    font-size:
      11px;
  }


  .order-date {

    font-size:
      9px;
  }


  .order-details {

    grid-template-columns:
      1fr 1fr;

    gap:
      20px 0;

    padding:
      20px 0;
  }


  .detail {

    padding:
      0 14px;

    border-right:
      none;
  }


  .detail:nth-child(odd) {

    padding-left:
      0;
  }


  .detail:nth-child(even) {

    padding-right:
      0;
  }


  .detail strong {

    font-size:
      10px;
  }


  .detail-label {

    font-size:
      6.5px;
  }


  .delivery {

    padding-top:
      19px;
  }


  .address {

    font-size:
      9px;
  }


  .card-bottom {

    margin-top:
      20px;
  }


  .cancel-button {

    width:
      100%;
  }

}


/* =====================================================
   SMALL PHONE
===================================================== */

@media (max-width: 380px) {

  .orders-page {

    padding:
      38px 10px 60px;
  }


  .orders-header h1 {

    font-size:
      33px;
  }


  .order-card {

    padding:
      18px 15px;
  }


  .order-number {

    font-size:
      10px;
  }


  .small-label {

    font-size:
      6px;
  }


  .order-details {

    gap:
      18px 0;
  }


  .detail strong {

    font-size:
      9px;
  }


  .delivery-content {

    gap:
      4px;
  }


  .empty-orders {

    padding:
      60px 18px;
  }

}

</style>
