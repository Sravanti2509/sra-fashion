---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="SRA Privacy Policy — Learn how SRA collects, uses and protects your information."
    />

    <title>Privacy Policy | SRA</title>
  </head>

  <body>

    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="policy-hero">

        <div class="policy-hero-inner">

          <span>
            SRA COLLECTION
          </span>

          <h1>
            Privacy<br />
            Policy.
          </h1>

          <p>
            Your privacy matters to us. This page explains
            how SRA handles information when you use our website.
          </p>

        </div>

        <div class="hero-scroll">

          <span>
            READ BELOW
          </span>

          <span class="scroll-line"></span>

        </div>

      </section>


      <!-- =====================================================
           CONTENT
      ====================================================== -->

      <section class="policy-section">

        <div class="policy-intro">

          <span>
            LAST UPDATED
          </span>

          <h2>
            Your privacy,<br />
            handled with care.
          </h2>

          <p>
            At SRA, we respect your privacy and are committed
            to protecting the information you share with us.
            This Privacy Policy describes the types of
            information we may collect and how we may use it.
          </p>

        </div>


        <div class="policy-content">

          <!-- 01 -->

          <article class="policy-block">

            <div class="policy-number">
              01
            </div>

            <div>

              <h3>
                Information We Collect
              </h3>

              <p>
                When you use the SRA website, we may collect
                information that you provide directly to us.
                This may include your name, email address,
                phone number, shipping address, billing details
                and information necessary to process your orders.
              </p>

              <p>
                We may also collect information about your
                interaction with our website, such as pages
                viewed, products selected and general usage
                information.
              </p>

            </div>

          </article>


          <!-- 02 -->

          <article class="policy-block">

            <div class="policy-number">
              02
            </div>

            <div>

              <h3>
                How We Use Your Information
              </h3>

              <p>
                Information collected through our website may
                be used to process and fulfil your orders,
                provide customer support, communicate with you,
                improve our website and provide a better shopping
                experience.
              </p>

              <p>
                If you subscribe to our newsletter, we may use
                your email address to send you updates about
                collections, products and SRA announcements.
              </p>

            </div>

          </article>


          <!-- 03 -->

          <article class="policy-block">

            <div class="policy-number">
              03
            </div>

            <div>

              <h3>
                Payments & Transactions
              </h3>

              <p>
                Payments made through the website may be
                processed by third-party payment providers.
                Payment information is handled according to
                the security and privacy practices of the
                relevant payment provider.
              </p>

              <p>
                SRA does not intentionally store complete
                payment card details on its own website systems.
              </p>

            </div>

          </article>


          <!-- 04 -->

          <article class="policy-block">

            <div class="policy-number">
              04
            </div>

            <div>

              <h3>
                Cookies & Website Data
              </h3>

              <p>
                Our website may use cookies or similar
                technologies to remember preferences, maintain
                functionality and understand how visitors use
                the website.
              </p>

              <p>
                You can manage or disable cookies through
                your browser settings. Some website features
                may not work correctly if cookies are disabled.
              </p>

            </div>

          </article>


          <!-- 05 -->

          <article class="policy-block">

            <div class="policy-number">
              05
            </div>

            <div>

              <h3>
                Information Sharing
              </h3>

              <p>
                We do not sell your personal information.
                Information may be shared with trusted service
                providers when necessary to operate our website,
                process payments, deliver orders or provide
                customer support.
              </p>

              <p>
                Such providers are expected to handle information
                responsibly and only for the purposes for which
                it is provided.
              </p>

            </div>

          </article>


          <!-- 06 -->

          <article class="policy-block">

            <div class="policy-number">
              06
            </div>

            <div>

              <h3>
                Data Security
              </h3>

              <p>
                We take reasonable steps to protect the
                information provided to us against unauthorized
                access, alteration, disclosure or misuse.
              </p>

              <p>
                However, no method of transmission or electronic
                storage can be guaranteed to be completely secure.
              </p>

            </div>

          </article>


          <!-- 07 -->

          <article class="policy-block">

            <div class="policy-number">
              07
            </div>

            <div>

              <h3>
                Your Choices
              </h3>

              <p>
                You may contact us if you would like to review,
                update or request deletion of personal information
                that you have provided to SRA, subject to applicable
                legal and operational requirements.
              </p>

              <p>
                You can also choose not to receive marketing
                communications by using the relevant unsubscribe
                option when available.
              </p>

            </div>

          </article>


          <!-- 08 -->

          <article class="policy-block">

            <div class="policy-number">
              08
            </div>

            <div>

              <h3>
                Changes to This Policy
              </h3>

              <p>
                SRA may update this Privacy Policy from time
                to time to reflect changes in our services,
                website or legal requirements.
              </p>

              <p>
                Any updated version will be published on this
                page with the revised date.
              </p>

            </div>

          </article>


          <!-- 09 -->

          <article class="policy-block">

            <div class="policy-number">
              09
            </div>

            <div>

              <h3>
                Contact Us
              </h3>

              <p>
                If you have questions about this Privacy Policy
                or how your information is handled, please contact
                SRA through the Contact Us page.
              </p>

              <a
                href="/contact"
                class="contact-link"
              >
                CONTACT SRA →
              </a>

            </div>

          </article>

        </div>

      </section>


      <!-- =====================================================
           STATEMENT
      ====================================================== -->

      <section class="policy-statement">

        <span>
          SRA
        </span>

        <h2>
          Your trust<br />
          matters.
        </h2>

        <p>
          We believe privacy should be simple,
          transparent and respected.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>


<style>

/* =====================================================
   RESET
===================================================== */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f6f2e9;
  color: #0b1f3a;
  font-family:
    Arial,
    Helvetica,
    sans-serif;
}

a {
  color: inherit;
}


/* =====================================================
   HERO
===================================================== */

.policy-hero {

  position: relative;

  min-height:
    calc(75vh - 80px);

  display: flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  border-bottom:
    1px solid #e3ddd1;
}


.policy-hero-inner {

  max-width:
    800px;

  padding:
    100px 25px 120px;
}


.policy-hero-inner > span {

  display: block;

  margin-bottom:
    25px;

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    3px;
}


.policy-hero h1 {

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(70px, 9vw, 125px);

  font-weight:
    400;

  line-height:
    .88;

  letter-spacing:
    -6px;
}


.policy-hero p {

  max-width:
    470px;

  margin:
    35px auto 0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


.hero-scroll {

  position:
    absolute;

  bottom:
    25px;

  left:
    50%;

  transform:
    translateX(-50%);

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    9px;

  color:
    #8b857b;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.5px;
}


.scroll-line {

  width:
    1px;

  height:
    30px;

  background:
    #b8b0a4;
}


/* =====================================================
   POLICY SECTION
===================================================== */

.policy-section {

  max-width:
    1100px;

  margin:
    0 auto;

  padding:
    130px 35px;
}


.policy-intro {

  max-width:
    720px;

  margin-bottom:
    90px;
}


.policy-intro > span {

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    2px;
}


.policy-intro h2 {

  margin:
    16px 0 25px;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 65px);

  font-weight:
    400;

  line-height:
    1;

  letter-spacing:
    -2px;
}


.policy-intro p {

  max-width:
    650px;

  margin:
    0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


/* =====================================================
   POLICY CONTENT
===================================================== */

.policy-content {

  border-top:
    1px solid #d8d1c5;
}


.policy-block {

  display:
    grid;

  grid-template-columns:
    90px 1fr;

  gap:
    35px;

  padding:
    55px 0;

  border-bottom:
    1px solid #d8d1c5;
}


.policy-number {

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    1px;
}


.policy-block h3 {

  margin:
    0 0 20px;

  font-family:
    Georgia,
    serif;

  font-size:
    29px;

  font-weight:
    400;

  letter-spacing:
    -.7px;
}


.policy-block p {

  max-width:
    700px;

  margin:
    0 0 15px;

  color:
    #777269;

  font-size:
    11px;

  line-height:
    1.9;
}


.policy-block p:last-of-type {

  margin-bottom:
    0;
}


/* =====================================================
   CONTACT LINK
===================================================== */

.contact-link {

  display:
    inline-flex;

  margin-top:
    20px;

  padding-bottom:
    7px;

  border-bottom:
    1px solid #0b1f3a;

  color:
    #0b1f3a;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    1.4px;

  text-decoration:
    none;

  transition:
    color .25s ease,
    border-color .25s ease;
}


.contact-link:hover {

  color:
    #b08c4d;

  border-color:
    #b08c4d;
}


/* =====================================================
   STATEMENT
===================================================== */

.policy-statement {

  padding:
    160px 25px;

  text-align:
    center;

  background:
    #0b1f3a;

  color:
    white;
}


.policy-statement > span {

  color:
    #c7a66b;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    2.5px;
}


.policy-statement h2 {

  margin:
    20px 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(60px, 8vw, 105px);

  font-weight:
    400;

  line-height:
    .9;

  letter-spacing:
    -5px;
}


.policy-statement p {

  margin:
    25px auto 0;

  color:
    #c9cbd0;

  font-size:
    11px;

  line-height:
    1.8;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 800px) {

  .policy-section {

    padding:
      110px 25px;
  }


  .policy-block {

    grid-template-columns:
      60px 1fr;

    gap:
      20px;
  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  body {
    overflow-x:
      hidden;
  }


  .policy-hero {

    min-height:
      calc(75vh - 70px);
  }


  .policy-hero-inner {

    padding:
      75px 20px 105px;
  }


  .policy-hero-inner > span {

    font-size:
      8px;

    letter-spacing:
      2.2px;
  }


  .policy-hero h1 {

    font-size:
      58px;

    letter-spacing:
      -3px;
  }


  .policy-hero p {

    max-width:
      310px;

    margin-top:
      27px;

    font-size:
      10px;
  }


  /* POLICY */

  .policy-section {

    padding:
      85px 20px;
  }


  .policy-intro {

    margin-bottom:
      60px;
  }


  .policy-intro h2 {

    font-size:
      36px;

    letter-spacing:
      -1.5px;
  }


  .policy-intro p {

    font-size:
      10px;

    line-height:
      1.8;
  }


  .policy-block {

    grid-template-columns:
      35px 1fr;

    gap:
      10px;

    padding:
      40px 0;
  }


  .policy-number {

    font-size:
      8px;
  }


  .policy-block h3 {

    font-size:
      23px;

    margin-bottom:
      15px;
  }


  .policy-block p {

    font-size:
      10px;

    line-height:
      1.8;
  }


  /* STATEMENT */

  .policy-statement {

    padding:
      110px 20px;
  }


  .policy-statement h2 {

    font-size:
      58px;

    letter-spacing:
      -3px;
  }


  .policy-statement p {

    font-size:
      9px;
  }

}


/* =====================================================
   SMALL PHONE
===================================================== */

@media (max-width: 380px) {

  .policy-hero h1 {

    font-size:
      51px;
  }


  .policy-intro h2 {

    font-size:
      32px;
  }


  .policy-block h3 {

    font-size:
      21px;
  }


  .policy-statement h2 {

    font-size:
      49px;
  }

}

</style>
