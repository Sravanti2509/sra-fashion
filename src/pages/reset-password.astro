```
<section class="reset-card">

  <div class="reset-header">
    <span class="eyebrow">SRA MEMBERS</span>

    <h1>Reset Password</h1>

    <p>
      Create a new password for your SRA account.
    </p>
  </div>

  <div
    id="resetMessage"
    class="reset-message"
  ></div>

  <form id="resetForm">

    <div class="form-group">

      <label for="password">
        NEW PASSWORD
      </label>

      <div class="password-wrapper">

        <input
          id="password"
          type="password"
          placeholder="Enter new password"
          autocomplete="new-password"
          minlength="6"
          required
        />

        <button
          type="button"
          id="togglePassword"
          class="password-toggle"
        >
