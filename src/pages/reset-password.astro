---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Reset Password | SRA</title>

</head>


<body>

  <Header />


  <main class="reset-page">

    <section class="reset-card">


      <!-- =========================
           HEADER
      ========================== -->

      <div class="reset-header">

        <span class="eyebrow">
          SRA MEMBERS
        </span>

        <h1>
          Reset Password
        </h1>

        <p>
          Create a new password for your SRA account.
        </p>

      </div>


      <!-- =========================
           MESSAGE
      ========================== -->

      <div
        id="resetMessage"
        class="reset-message"
      ></div>


      <!-- =========================
           RESET FORM
      ========================== -->

      <form id="resetForm">

        <div class="form-group">

          <label for="password">
            NEW PASSWORD
          </label>

          <div class="password-wrapper">

            <input
              id="password"
              type="password"
              placeholder="Enter new password"
              autocomplete="new-password"
              required
            />

            <button
              type="button"
              id="togglePassword"
              class="password-toggle"
            >
              SHOW
            </button>

          </div>

        </div>


        <div class="form-group">

          <label for="confirmPassword">
            CONFIRM PASSWORD
          </label>

          <div class="password-wrapper">

            <input
              id="confirmPassword"
              type="password"
              placeholder="Confirm new password"
              autocomplete="new-password"
              required
            />

            <button
              type="button"
              id="toggleConfirmPassword"
              class="password-toggle"
            >
              SHOW
            </button>

          </div>

        </div>


        <div class="password-info">
          Password must contain at least 6 characters.
        </div>


        <button
          type="submit"
          id="resetButton"
          class="reset-button"
        >
          UPDATE PASSWORD
        </button>

      </form>


      <div class="back-login">

        <a href="/login">
          ← BACK TO LOGIN
        </a>

      </div>


    </section>

  </main>


  <Footer />


  <!-- =========================
       SUPABASE
  ========================== -->

  <script>

    import { createClient } from "@supabase/supabase-js";


    /* =========================
       ENV
    ========================== */

    const supabaseUrl =
      import.meta.env.PUBLIC_SUPABASE_URL;

    const supabaseAnonKey =
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY;


    if (!supabaseUrl || !supabaseAnonKey) {

      console.error(
        "Supabase environment variables are missing."
      );

    }


    /* =========================
       CLIENT
    ========================== */

    const supabase =
      createClient(
        supabaseUrl,
        supabaseAnonKey,
        {
          auth: {

            /*
             * IMPORTANT
             *
             * Implicit flow allows the
             * recovery session to be received
             * in the browser.
             */

            flowType: "implicit",

            persistSession: true,

            autoRefreshToken: true,

            detectSessionInUrl: true

          }
        }
      );


    /* =========================
       ELEMENTS
    ========================== */

    const form =
      document.querySelector("#resetForm");

    const passwordInput =
      document.querySelector("#password");

    const confirmInput =
      document.querySelector("#confirmPassword");

    const message =
      document.querySelector("#resetMessage");

    const button =
      document.querySelector("#resetButton");

    const togglePassword =
      document.querySelector("#togglePassword");

    const toggleConfirmPassword =
      document.querySelector(
        "#toggleConfirmPassword"
      );


    /* =========================
       STATE
    ========================== */

    let recoverySessionReady =
      false;


    /* =========================
       MESSAGE
    ========================== */

    function showMessage(
      text,
      type = ""
    ) {

      if (!message) return;

      message.textContent = text;

      message.className =
        `reset-message ${type}`;

    }


    /* =========================
       PASSWORD TOGGLE
    ========================== */

    togglePassword?.addEventListener(
      "click",
      () => {

        if (!passwordInput) return;

        if (
          passwordInput.type === "password"
        ) {

          passwordInput.type = "text";

          togglePassword.textContent =
            "HIDE";

        } else {

          passwordInput.type = "password";

          togglePassword.textContent =
            "SHOW";

        }

      }
    );


    /* =========================
       CONFIRM TOGGLE
    ========================== */

    toggleConfirmPassword?.addEventListener(
      "click",
      () => {

        if (!confirmInput) return;

        if (
          confirmInput.type === "password"
        ) {

          confirmInput.type = "text";

          toggleConfirmPassword.textContent =
            "HIDE";

        } else {

          confirmInput.type = "password";

          toggleConfirmPassword.textContent =
            "SHOW";

        }

      }
    );


    /* =========================
       CHECK RECOVERY SESSION
    ========================== */

    async function checkRecoverySession() {

      try {

        console.log(
          "Checking Supabase recovery session..."
        );


        /* =========================
           CURRENT SESSION
        ========================== */

        const {
          data,
          error
        } =
          await supabase.auth.getSession();


        console.log(
          "INITIAL SESSION:",
          data?.session
        );


        if (error) {

          console.error(
            "GET SESSION ERROR:",
            error
          );

        }


        /*
         * If Supabase already detected
         * the recovery session.
         */

        if (data?.session) {

          recoverySessionReady =
            true;

          showMessage(
            "Enter your new password below.",
            "success"
          );

          return;

        }


        /* =========================
           LISTEN FOR RECOVERY EVENT
        ========================== */

        const {
          data: authListener
        } =
          supabase.auth.onAuthStateChange(
            async (
              event,
              session
            ) => {

              console.log(
                "SUPABASE AUTH EVENT:",
                event
              );


              if (
                event ===
                "PASSWORD_RECOVERY"
              ) {

                if (session) {

                  recoverySessionReady =
                    true;

                  showMessage(
                    "Enter your new password below.",
                    "success"
                  );

                }

              }


              if (
                event ===
                "SIGNED_IN"
              ) {

                if (session) {

                  recoverySessionReady =
                    true;

                  showMessage(
                    "Enter your new password below.",
                    "success"
                  );

                }

              }

            }
          );


        /* =========================
           WAIT FOR URL SESSION
        ========================== */

        setTimeout(
          async () => {

            if (recoverySessionReady) {
              return;
            }


            const {
              data: retryData
            } =
              await supabase.auth.getSession();


            console.log(
              "RETRY SESSION:",
              retryData?.session
            );


            if (
              retryData?.session
            ) {

              recoverySessionReady =
                true;

              showMessage(
                "Enter your new password below.",
                "success"
              );

            } else {

              showMessage(
                "This reset link is invalid or expired. Please request a new reset link.",
                "error"
              );

            }

          },
          1500
        );


      } catch (error) {

        console.error(
          "RECOVERY SESSION ERROR:",
          error
        );

        showMessage(
          "Unable to verify the reset link.",
          "error"
        );

      }

    }


    /* =========================
       START
    ========================== */

    await checkRecoverySession();


    /* =========================
       UPDATE PASSWORD
    ========================== */

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        /* =========================
           GET CURRENT SESSION
        ========================== */

        const {
          data,
          error: sessionError
        } =
          await supabase.auth.getSession();


        const session =
          data?.session;


        console.log(
          "SESSION BEFORE PASSWORD UPDATE:",
          session
        );


        if (
          sessionError ||
          !session
        ) {

          showMessage(
            "Your reset session is missing or expired. Please request a new reset link.",
            "error"
          );

          return;

        }


        /* =========================
           PASSWORDS
        ========================== */

        const password =
          passwordInput?.value.trim() || "";

        const confirmPassword =
          confirmInput?.value.trim() || "";


        /* =========================
           VALIDATION
        ========================== */

        if (
          password.length < 6
        ) {

          showMessage(
            "Password must be at least 6 characters.",
            "error"
          );

          return;

        }


        if (
          password !== confirmPassword
        ) {

          showMessage(
            "Passwords do not match.",
            "error"
          );

          return;

        }


        /* =========================
           LOADING
        ========================== */

        if (
          button instanceof
          HTMLButtonElement
        ) {

          button.disabled = true;

          button.textContent =
            "UPDATING...";

        }


        try {

          /* =========================
             UPDATE
          ========================== */

          const {
            data: updateData,
            error
          } =
            await supabase.auth.updateUser({
              password: password
            });


          console.log(
            "PASSWORD UPDATE:",
            updateData,
            error
          );


          /* =========================
             ERROR
          ========================== */

          if (error) {

            console.error(
              "PASSWORD UPDATE ERROR:",
              error
            );


            showMessage(
              error.message,
              "error"
            );


            if (
              button instanceof
              HTMLButtonElement
            ) {

              button.disabled = false;

              button.textContent =
                "UPDATE PASSWORD";

            }

            return;

          }


          /* =========================
             SUCCESS
          ========================== */

          showMessage(
            "Password updated successfully!",
            "success"
          );


          if (
            button instanceof
            HTMLButtonElement
          ) {

            button.disabled = true;

            button.textContent =
              "PASSWORD UPDATED";

          }


          /* =========================
             CLEAR LOCAL APP USER
          ========================== */

          localStorage.removeItem(
            "sra-user"
          );


          /* =========================
             SIGN OUT
          ========================== */

          await supabase.auth.signOut();


          /* =========================
             LOGIN
          ========================== */

          setTimeout(
            () => {

              window.location.replace(
                "/login"
              );

            },
            1200
          );


        } catch (error) {

          console.error(
            "PASSWORD RESET ERROR:",
            error
          );


          showMessage(
            "Something went wrong. Please try again.",
            "error"
          );


          if (
            button instanceof
            HTMLButtonElement
          ) {

            button.disabled = false;

            button.textContent =
              "UPDATE PASSWORD";

          }

        }

      }
    );

  </script>

</body>

</html>


<style>

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  background: #f5f1e8;

  color: #0b1f3a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


.reset-page {

  min-height: 650px;

  padding:
    90px 20px;

  display: flex;

  justify-content: center;

  align-items: flex-start;
}


.reset-card {

  width: 100%;

  max-width: 500px;

  padding: 45px;

  background: #faf8f3;

  border:
    1px solid #ded7cc;

  box-shadow:
    0 20px 60px
    rgba(11, 31, 58, 0.06);
}


.reset-header {

  text-align: center;

  margin-bottom: 35px;
}


.eyebrow {

  display: block;

  margin-bottom: 13px;

  color: #b79b63;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 2px;
}


.reset-header h1 {

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 42px;

  font-weight: 400;

  letter-spacing: -1px;
}


.reset-header p {

  max-width: 350px;

  margin:
    15px auto 0;

  color: #777269;

  font-size: 11px;

  line-height: 1.7;
}


.reset-message {

  min-height: 20px;

  margin-bottom: 18px;

  text-align: center;

  font-size: 10px;

  line-height: 1.5;
}


.reset-message.error {
  color: #9f3040;
}


.reset-message.success {
  color: #47704d;
}


.form-group {
  margin-bottom: 22px;
}


.form-group label {

  display: block;

  margin-bottom: 8px;

  color: #0b1f3a;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 1.2px;
}


.password-wrapper {

  position: relative;

  display: flex;

  align-items: center;
}


.form-group input {

  width: 100%;

  height: 52px;

  padding:
    0 70px 0 14px;

  border:
    1px solid #d4cdc2;

  outline: none;

  background: #ffffff;

  color: #0b1f3a;

  font-size: 12px;
}


.form-group input::placeholder {
  color: #aaa49c;
}


.form-group input:focus {

  border-color: #0b1f3a;

  box-shadow:
    0 0 0 2px
    rgba(11, 31, 58, 0.05);
}


.password-toggle {

  position: absolute;

  right: 12px;

  border: 0;

  background: transparent;

  color: #0b1f3a;

  font-size: 7px;

  font-weight: 700;

  letter-spacing: 1px;

  cursor: pointer;
}


.password-info {

  margin-top: -8px;

  margin-bottom: 22px;

  color: #777269;

  font-size: 9px;
}


.reset-button {

  width: 100%;

  height: 53px;

  border:
    1px solid #0b1f3a;

  background: #0b1f3a;

  color: #ffffff;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 1.5px;

  cursor: pointer;

  transition:
    0.25s ease;
}


.reset-button:hover {

  background: transparent;

  color: #0b1f3a;
}


.reset-button:disabled {

  opacity: 0.6;

  cursor: not-allowed;
}


.back-login {

  margin-top: 25px;

  text-align: center;
}


.back-login a {

  color: #0b1f3a;

  text-decoration: none;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 1.3px;
}


.back-login a:hover {
  color: #b79b63;
}


@media (max-width: 600px) {

  .reset-page {

    padding:
      55px 14px 70px;
  }

  .reset-card {

    padding:
      30px 22px;
  }

  .reset-header h1 {

    font-size: 34px;
  }

}


@media (max-width: 380px) {

  .reset-page {

    padding:
      40px 10px 60px;
  }

  .reset-card {

    padding:
      25px 17px;
  }

  .reset-header h1 {

    font-size: 31px;
  }

}

</style>