        </button>

      </div>

    </div>

    <div class="form-group">

      <label for="confirmPassword">
        CONFIRM PASSWORD
      </label>

      <div class="password-wrapper">

        <input
          id="confirmPassword"
          type="password"
          placeholder="Confirm new password"
          autocomplete="new-password"
          minlength="6"
          required
        />

        <button
          type="button"
          id="toggleConfirmPassword"
