---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="SRA Terms & Conditions — Terms governing the use of the SRA website and services."
    />

    <title>Terms & Conditions | SRA</title>
  </head>

  <body>

    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="terms-hero">

        <div class="terms-hero-inner">

          <span>
            SRA COLLECTION
          </span>

          <h1>
            Terms &<br />
            Conditions.
          </h1>

          <p>
            Please read these terms carefully before
            using the SRA website or placing an order.
          </p>

        </div>

        <div class="hero-scroll">

          <span>
            READ BELOW
          </span>

          <span class="scroll-line"></span>

        </div>

      </section>


      <!-- =====================================================
           TERMS CONTENT
      ====================================================== -->

      <section class="terms-section">

        <div class="terms-intro">

          <span>
            LAST UPDATED
          </span>

          <h2>
            Simple terms.<br />
            Clear expectations.
          </h2>

          <p>
            These Terms & Conditions describe the rules
            and conditions that apply when you access or
            use the SRA website and purchase products from us.
          </p>

        </div>


        <div class="terms-content">

          <!-- 01 -->

          <article class="terms-block">

            <div class="terms-number">
              01
            </div>

            <div>

              <h3>
                Acceptance of Terms
              </h3>

              <p>
                By accessing or using the SRA website,
                you agree to comply with these Terms &
                Conditions and any applicable laws and regulations.
              </p>

              <p>
                If you do not agree with these terms,
                please do not use the website or place
                an order through it.
              </p>

            </div>

          </article>


          <!-- 02 -->

          <article class="terms-block">

            <div class="terms-number">
              02
            </div>

            <div>

              <h3>
                About SRA
              </h3>

              <p>
                SRA is an online fashion store offering
                clothing and related products through
                its website.
              </p>

              <p>
                Product descriptions, images, prices and
                availability may be updated from time to
                time without prior notice.
              </p>

            </div>

          </article>


          <!-- 03 -->

          <article class="terms-block">

            <div class="terms-number">
              03
            </div>

            <div>

              <h3>
                Products & Availability
              </h3>

              <p>
                We make reasonable efforts to ensure that
                product information displayed on the website
                is accurate and up to date.
              </p>

              <p>
                However, product availability may change
                without notice. If an ordered product becomes
                unavailable, SRA may contact you regarding
                the order or provide an appropriate resolution.
              </p>

            </div>

          </article>


          <!-- 04 -->

          <article class="terms-block">

            <div class="terms-number">
              04
            </div>

            <div>

              <h3>
                Product Images & Colours
              </h3>

              <p>
                We try to display product colours and
                images as accurately as possible.
                However, the appearance of colours may
                vary depending on your device or screen.
              </p>

              <p>
                Minor differences between displayed images
                and the actual product may therefore occur.
              </p>

            </div>

          </article>


          <!-- 05 -->

          <article class="terms-block">

            <div class="terms-number">
              05
            </div>

            <div>

              <h3>
                Pricing
              </h3>

              <p>
                Product prices displayed on the SRA website
                are shown in Indian Rupees unless otherwise
                stated.
              </p>

              <p>
                Prices, offers and promotions may be changed
                or withdrawn at any time. Any applicable
                charges will be shown during checkout where
                relevant.
              </p>

            </div>

          </article>


          <!-- 06 -->

          <article class="terms-block">

            <div class="terms-number">
              06
            </div>

            <div>

              <h3>
                Orders
              </h3>

              <p>
                When you place an order, you are submitting
                a request to purchase the selected products.
                An order confirmation does not necessarily
                guarantee that the order will be fulfilled.
              </p>

              <p>
                SRA reserves the right to cancel or refuse
                an order in situations such as product
                unavailability, pricing errors, payment issues
                or suspected fraudulent activity.
              </p>

            </div>

          </article>


          <!-- 07 -->

          <article class="terms-block">

            <div class="terms-number">
              07
            </div>

            <div>

              <h3>
                Payments
              </h3>

              <p>
                Payments may be processed through third-party
                payment providers. By completing a payment,
                you agree to the applicable terms of the
                payment provider.
              </p>

              <p>
                SRA does not intentionally store complete
                payment card information on its own systems.
              </p>

            </div>

          </article>


          <!-- 08 -->

          <article class="terms-block">

            <div class="terms-number">
              08
            </div>

            <div>

              <h3>
                Shipping & Delivery
              </h3>

              <p>
                Orders are shipped to the address provided
                during checkout. Delivery timelines may vary
                depending on location, courier availability,
                weather and other circumstances.
              </p>

              <p>
                For more information about delivery,
                please visit our Shipping & Delivery page.
              </p>

              <a
                href="/shipping"
                class="terms-link"
              >
                SHIPPING & DELIVERY →
              </a>

            </div>

          </article>


          <!-- 09 -->

          <article class="terms-block">

            <div class="terms-number">
              09
            </div>

            <div>

              <h3>
                Returns & Exchanges
              </h3>

              <p>
                Returns and exchanges are subject to the
                conditions specified in our Returns &
                Exchanges policy.
              </p>

              <p>
                Customers should review the applicable
                return requirements before requesting
                a return or exchange.
              </p>

              <a
                href="/returns"
                class="terms-link"
              >
                RETURNS & EXCHANGES →
              </a>

            </div>

          </article>


          <!-- 10 -->

          <article class="terms-block">

            <div class="terms-number">
              10
            </div>

            <div>

              <h3>
                Website Use
              </h3>

              <p>
                You agree to use the SRA website only
                for lawful purposes and in a manner that
                does not interfere with the operation,
                security or availability of the website.
              </p>

              <p>
                You must not attempt to gain unauthorized
                access to website systems, accounts or
                information belonging to SRA or other users.
              </p>

            </div>

          </article>


          <!-- 11 -->

          <article class="terms-block">

            <div class="terms-number">
              11
            </div>

            <div>

              <h3>
                Intellectual Property
              </h3>

              <p>
                The SRA website, including its branding,
                logos, text, images, graphics, design and
                other content, may be protected by applicable
                intellectual property laws.
              </p>

              <p>
                Content from the website should not be
                reproduced, copied, modified or distributed
                without appropriate permission.
              </p>

            </div>

          </article>


          <!-- 12 -->

          <article class="terms-block">

            <div class="terms-number">
              12
            </div>

            <div>

              <h3>
                Limitation of Liability
              </h3>

              <p>
                SRA makes reasonable efforts to keep the
                website available and information accurate.
                However, we do not guarantee that the website
                will always be uninterrupted, error-free or
                completely secure.
              </p>

              <p>
                To the extent permitted by applicable law,
                SRA will not be responsible for losses arising
                from circumstances outside our reasonable control.
              </p>

            </div>

          </article>


          <!-- 13 -->

          <article class="terms-block">

            <div class="terms-number">
              13
            </div>

            <div>

              <h3>
                Changes to These Terms
              </h3>

              <p>
                SRA may update these Terms & Conditions
                from time to time. Changes will be published
                on this page and will apply from the date
                they are posted.
              </p>

              <p>
                We recommend checking this page periodically
                for any updates.
              </p>

            </div>

          </article>


          <!-- 14 -->

          <article class="terms-block">

            <div class="terms-number">
              14
            </div>

            <div>

              <h3>
                Contact Us
              </h3>

              <p>
                If you have questions about these Terms &
                Conditions, please contact SRA through
                our Contact Us page.
              </p>

              <a
                href="/contact"
                class="terms-link"
              >
                CONTACT SRA →
              </a>

            </div>

          </article>

        </div>

      </section>


      <!-- =====================================================
           STATEMENT
      ====================================================== -->

      <section class="terms-statement">

        <span>
          SRA
        </span>

        <h2>
          Clear terms.<br />
          Confident shopping.
        </h2>

        <p>
          Thank you for choosing SRA.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>


<style>

/* =====================================================
   RESET
===================================================== */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  background: #f6f2e9;

  color: #0b1f3a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}

a {
  color: inherit;
}


/* =====================================================
   HERO
===================================================== */

.terms-hero {

  position: relative;

  min-height:
    calc(75vh - 80px);

  display: flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  border-bottom:
    1px solid #e3ddd1;
}


.terms-hero-inner {

  max-width:
    900px;

  padding:
    100px 25px 120px;
}


.terms-hero-inner > span {

  display: block;

  margin-bottom:
    25px;

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    3px;
}


.terms-hero h1 {

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(65px, 8vw, 115px);

  font-weight:
    400;

  line-height:
    .88;

  letter-spacing:
    -5px;
}


.terms-hero p {

  max-width:
    470px;

  margin:
    35px auto 0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


/* =====================================================
   HERO SCROLL
===================================================== */

.hero-scroll {

  position:
    absolute;

  bottom:
    25px;

  left:
    50%;

  transform:
    translateX(-50%);

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    9px;

  color:
    #8b857b;

  font-size:
    7px;

  font-weight:
    700;

  letter-spacing:
    1.5px;
}


.scroll-line {

  width:
    1px;

  height:
    30px;

  background:
    #b8b0a4;
}


/* =====================================================
   TERMS SECTION
===================================================== */

.terms-section {

  max-width:
    1100px;

  margin:
    0 auto;

  padding:
    130px 35px;
}


.terms-intro {

  max-width:
    720px;

  margin-bottom:
    90px;
}


.terms-intro > span {

  color:
    #b08c4d;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    2px;
}


.terms-intro h2 {

  margin:
    16px 0 25px;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(42px, 5vw, 65px);

  font-weight:
    400;

  line-height:
    1;

  letter-spacing:
    -2px;
}


.terms-intro p {

  max-width:
    650px;

  margin:
    0;

  color:
    #777269;

  font-size:
    12px;

  line-height:
    1.9;
}


/* =====================================================
   TERMS CONTENT
===================================================== */

.terms-content {

  border-top:
    1px solid #d8d1c5;
}


.terms-block {

  display:
    grid;

  grid-template-columns:
    90px 1fr;

  gap:
    35px;

  padding:
    55px 0;

  border-bottom:
    1px solid #d8d1c5;
}


.terms-number {

  color:
    #b08c4d;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    1px;
}


.terms-block h3 {

  margin:
    0 0 20px;

  font-family:
    Georgia,
    serif;

  font-size:
    29px;

  font-weight:
    400;

  letter-spacing:
    -.7px;
}


.terms-block p {

  max-width:
    700px;

  margin:
    0 0 15px;

  color:
    #777269;

  font-size:
    11px;

  line-height:
    1.9;
}


.terms-block p:last-of-type {

  margin-bottom:
    0;
}


/* =====================================================
   LINKS
===================================================== */

.terms-link {

  display:
    inline-flex;

  margin-top:
    20px;

  padding-bottom:
    7px;

  border-bottom:
    1px solid #0b1f3a;

  color:
    #0b1f3a;

  font-size:
    8px;

  font-weight:
    700;

  letter-spacing:
    1.4px;

  text-decoration:
    none;

  transition:
    color .25s ease,
    border-color .25s ease;
}


.terms-link:hover {

  color:
    #b08c4d;

  border-color:
    #b08c4d;
}


/* =====================================================
   STATEMENT
===================================================== */

.terms-statement {

  padding:
    160px 25px;

  text-align:
    center;

  background:
    #0b1f3a;

  color:
    white;
}


.terms-statement > span {

  color:
    #c7a66b;

  font-size:
    9px;

  font-weight:
    700;

  letter-spacing:
    2.5px;
}


.terms-statement h2 {

  margin:
    20px 0;

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(55px, 7vw, 100px);

  font-weight:
    400;

  line-height:
    .9;

  letter-spacing:
    -4px;
}


.terms-statement p {

  margin:
    25px auto 0;

  color:
    #c9cbd0;

  font-size:
    11px;

  line-height:
    1.8;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 800px) {

  .terms-section {

    padding:
      110px 25px;
  }


  .terms-block {

    grid-template-columns:
      60px 1fr;

    gap:
      20px;
  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  body {
    overflow-x:
      hidden;
  }


  .terms-hero {

    min-height:
      calc(75vh - 70px);
  }


  .terms-hero-inner {

    padding:
      75px 20px 105px;
  }


  .terms-hero-inner > span {

    font-size:
      8px;

    letter-spacing:
      2.2px;
  }


  .terms-hero h1 {

    font-size:
      55px;

    letter-spacing:
      -3px;
  }


  .terms-hero p {

    max-width:
      310px;

    margin-top:
      27px;

    font-size:
      10px;
  }


  /* TERMS */

  .terms-section {

    padding:
      85px 20px;
  }


  .terms-intro {

    margin-bottom:
      60px;
  }


  .terms-intro h2 {

    font-size:
      36px;

    letter-spacing:
      -1.5px;
  }


  .terms-intro p {

    font-size:
      10px;

    line-height:
      1.8;
  }


  .terms-block {

    grid-template-columns:
      35px 1fr;

    gap:
      10px;

    padding:
      40px 0;
  }


  .terms-number {

    font-size:
      8px;
  }


  .terms-block h3 {

    font-size:
      23px;

    margin-bottom:
      15px;
  }


  .terms-block p {

    font-size:
      10px;

    line-height:
      1.8;
  }


  /* STATEMENT */

  .terms-statement {

    padding:
      110px 20px;
  }


  .terms-statement h2 {

    font-size:
      52px;

    letter-spacing:
      -3px;
  }


  .terms-statement p {

    font-size:
      9px;
  }

}


/* =====================================================
   SMALL PHONE
===================================================== */

@media (max-width: 380px) {

  .terms-hero h1 {

    font-size:
      49px;
  }


  .terms-intro h2 {

    font-size:
      32px;
  }


  .terms-block h3 {

    font-size:
      21px;
  }


  .terms-statement h2 {

    font-size:
      44px;
  }

}

</style>
